#!/usr/bin/env bash
# Batch transcribe an audio file to markdown.
#
# Modes
#   local : when run on $TRANSCRIBE_HOSTNAME, invoke faster-whisper directly
#   remote: otherwise, scp the file to the host, transcribe there, scp the .md back
#
# Stdout contract
#   On success, exactly one line is printed to stdout: the absolute path of the
#   markdown transcript. All progress/log output goes to stderr. This makes the
#   script safe to invoke from n8n executeCommand (capture .stdout = path).
#
# --archive-s3
#   BACKUP-FIRST POLICY (the audio is the irreplaceable artifact):
#   BEFORE transcription runs, upload the source audio to
#   s3://${TRANSCRIBE_S3_BUCKET:-recordings}/YYYY-MM-DD/HHMMSS-<filename> via
#   `mc` (alias ${TRANSCRIBE_S3_ALIAS:-delo}) using the file's mtime for the
#   key, and VERIFY it landed (mc stat). The local source is NEVER deleted.
#   If the upload fails, we keep the source AND drop a safety copy into
#   $TRANSCRIBE_STASH_DIR (a non-synced local vault) so the audio cannot be
#   lost even if S3 is down or the inbox (a receive-only Syncthing folder with
#   no versioning) is cleared by a remote peer. Transcription still proceeds
#   so a backup hiccup never costs us the transcript too.

set -euo pipefail

TRANSCRIBE_HOSTNAME="${TRANSCRIBE_HOSTNAME:-big-chungus}"
TRANSCRIBE_HOST="${TRANSCRIBE_HOST:-192.168.1.12}"
TRANSCRIBE_USER="${TRANSCRIBE_USER:-delorenj}"
# Derive the repo dir from THIS script's real path (it's invoked via a
# ~/.local/bin symlink), so it keeps working when HeyMa is relocated. HeyMa
# moved code/33GOD/HeyMa -> code/HeyMa (~2026-07-01) and the old hardcoded path
# silently broke every transcription for two weeks. Self-locating prevents a repeat.
_TRANSCRIBE_SELF="$(realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
_TRANSCRIBE_DEFAULT_DIR="$(cd "$(dirname "$_TRANSCRIBE_SELF")/.." 2>/dev/null && pwd)" || _TRANSCRIBE_DEFAULT_DIR="/home/delorenj/code/HeyMa"
TRANSCRIBE_DIR="${TRANSCRIBE_DIR:-$_TRANSCRIBE_DEFAULT_DIR}"
REMOTE="${TRANSCRIBE_USER}@${TRANSCRIBE_HOST}"
MISE_INIT='source ~/.profile 2>/dev/null; eval "$(mise activate bash)" 2>/dev/null'
DIARIZATION_VENV="${DIARIZATION_VENV:-${TRANSCRIBE_DIR}/.venv-diarization}"
DIARIZATION_PYTHON="${DIARIZATION_PYTHON:-${DIARIZATION_VENV}/bin/python}"

S3_ALIAS="${TRANSCRIBE_S3_ALIAS:-delo}"
S3_BUCKET="${TRANSCRIBE_S3_BUCKET:-recordings}"
MC_BIN="${MC_BIN:-/usr/local/bin/mc}"
MAX_AUDIO_FILE_SIZE_FOR_TRANSCRIPTION="${MAX_AUDIO_FILE_SIZE_FOR_TRANSCRIPTION:-300MB}"
MAX_AUDIO_DURATION_FOR_TRANSCRIPTION="${MAX_AUDIO_DURATION_FOR_TRANSCRIPTION:-3h}"

log() { printf '%s\n' "$*" >&2; }

size_bytes() {
  local value="${1^^}" number unit multiplier
  value="${value//[[:space:]]/}"
  if [[ "$value" =~ ^([0-9]+)(B|KB|MB|GB|KIB|MIB|GIB)?$ ]]; then
    number="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]:-B}"
  else
    log "[error] Invalid MAX_AUDIO_FILE_SIZE_FOR_TRANSCRIPTION: $1"
    return 2
  fi
  case "$unit" in
    B) multiplier=1 ;;
    KB) multiplier=1000 ;;
    MB) multiplier=1000000 ;;
    GB) multiplier=1000000000 ;;
    KIB) multiplier=1024 ;;
    MIB) multiplier=1048576 ;;
    GIB) multiplier=1073741824 ;;
  esac
  printf '%s\n' "$((number * multiplier))"
}

enforce_transcription_size_limit() {
  local actual limit
  actual="$(stat -c %s -- "$AUDIO")"
  limit="$(size_bytes "$MAX_AUDIO_FILE_SIZE_FOR_TRANSCRIPTION")"
  if ((actual >= limit)); then
    log "[blocked] Audio is ${actual} bytes; MAX_AUDIO_FILE_SIZE_FOR_TRANSCRIPTION=${limit} bytes."
    return 65
  fi
}

duration_seconds() {
  local value="${1^^}" number unit multiplier
  value="${value//[[:space:]]/}"
  if [[ "$value" =~ ^([0-9]+)(S|M|H)?$ ]]; then
    number="${BASH_REMATCH[1]}"
    unit="${BASH_REMATCH[2]:-S}"
  else
    log "[error] Invalid MAX_AUDIO_DURATION_FOR_TRANSCRIPTION: $1"
    return 2
  fi
  case "$unit" in
    S) multiplier=1 ;;
    M) multiplier=60 ;;
    H) multiplier=3600 ;;
  esac
  printf '%s\n' "$((number * multiplier))"
}

enforce_transcription_duration_limit() {
  local actual actual_whole limit
  actual="$(ffprobe -v error -show_entries format=duration \
    -of default=nw=1:nk=1 -- "$AUDIO" 2>/dev/null || true)"
  [[ -n "$actual" ]] || return 0
  actual_whole="${actual%%.*}"
  limit="$(duration_seconds "$MAX_AUDIO_DURATION_FOR_TRANSCRIPTION")"
  if ((actual_whole >= limit)); then
    log "[blocked] Audio is ${actual}s; MAX_AUDIO_DURATION_FOR_TRANSCRIPTION=${limit}s."
    return 66
  fi
}

AUDIO="${1:?Usage: transcribe <audio-file> [options] [--archive-s3]}"
shift
ARCHIVE_S3=false
EXTRA_ARGS=()
while (("$#" > 0)); do
  case "$1" in
    --archive-s3) ARCHIVE_S3=true; shift ;;
    *) EXTRA_ARGS+=("$1"); shift ;;
  esac
done

AUDIO="$(realpath "$AUDIO")"

is_local() { [[ "$(hostname)" == "${TRANSCRIBE_HOSTNAME}" ]]; }

has_arg() {
  local needle="$1" arg
  if ((${#EXTRA_ARGS[@]} == 0)); then return 1; fi
  for arg in "${EXTRA_ARGS[@]}"; do
    [[ "$arg" == "$needle" || "$arg" == "${needle}="* ]] && return 0
  done
  return 1
}

should_retry_on_cpu() {
  has_arg --device && return 1
  has_arg --groq && return 1
  return 0
}

run_local_transcribe() {
  local force_cpu="${1:-false}"
  local -a cmd_args runner
  local cudnn_lib_dir=""

  # Ensure cuDNN wheel libs are visible at process start.
  # cuDNN 9 dispatches to multiple sub-libraries by SONAME during inference.
  if [[ -x "$DIARIZATION_PYTHON" ]]; then
    cudnn_lib_dir="$($DIARIZATION_PYTHON - <<'PY' 2>/dev/null || true
import site
from pathlib import Path
for base in site.getsitepackages():
    p = Path(base) / 'nvidia' / 'cudnn' / 'lib'
    if (p / 'libcudnn_ops.so.9').exists():
        print(p)
        break
PY
)"
  fi
  if [[ -z "$cudnn_lib_dir" ]]; then
    cudnn_lib_dir="$(uv run python - <<'PY' 2>/dev/null || true
import site
from pathlib import Path
for base in site.getsitepackages():
    p = Path(base) / 'nvidia' / 'cudnn' / 'lib'
    if (p / 'libcudnn_ops.so.9').exists():
        print(p)
        break
PY
)"
  fi
  if [[ -n "$cudnn_lib_dir" ]]; then
    export LD_LIBRARY_PATH="$cudnn_lib_dir${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
  fi

  cmd_args=("$AUDIO")
  if ((${#EXTRA_ARGS[@]} > 0)); then cmd_args+=("${EXTRA_ARGS[@]}"); fi
  [[ "$force_cpu" == "true" ]] && cmd_args+=("--device" "cpu")

  # Prefer the dedicated diarization venv (.venv-diarization) when present: it
  # carries nemo_toolkit[asr] + librosa on top of the GPU faster-whisper stack.
  # When it exists we AUTO-ENABLE speaker diarization so a bare `transcribe
  # <file>` (how the n8n pipeline invokes it) "just works". This is safe:
  # transcribe.py guards --diarization (if deps are missing it logs a warning
  # and continues without speaker labels), and diarize_local() degrades
  # gracefully on any runtime error. We do NOT auto-add it for the Groq API
  # path (no local diarization there) or if the caller already passed the flag.
  # When the venv is absent we fall back to the main uv env and stay fast by
  # NOT diarizing (its deps are intentionally not installed).
  if [[ -x "$DIARIZATION_PYTHON" ]]; then
    runner=(nice -n 15 "$DIARIZATION_PYTHON")
    if ! has_arg --diarization && ! has_arg --no-diarization && ! has_arg --groq; then
      cmd_args+=("--diarization")
    fi
  else
    log "[warn] Diarization venv ${DIARIZATION_PYTHON} missing; diarization will be skipped."
    log "[warn] Create it with: uv venv --python 3.12 .venv-diarization && uv pip install --python .venv-diarization/bin/python -e . 'nemo_toolkit[asr]'"
    runner=(nice -n 15 mise x -- uv run python)
  fi

  ( cd "$TRANSCRIBE_DIR" && PYTHONUNBUFFERED=1 "${runner[@]}" scripts/transcribe.py "${cmd_args[@]}" )
}

run_remote_transcribe() {
  local force_cpu="${1:-false}"
  local -a remote_args=()
  local escaped_args=""
  local runner_cmd="mise x -- uv run python"
  if ((${#EXTRA_ARGS[@]} > 0)); then remote_args=("${EXTRA_ARGS[@]}"); fi
  [[ "$force_cpu" == "true" ]] && remote_args+=("--device" "cpu")
  # Auto-enable diarization when the remote host has the diarization venv, matching
  # the local path. Guarded the same way (not for --groq / already-passed).
  if ssh -q "$REMOTE" "test -x '${DIARIZATION_PYTHON}'"; then
    runner_cmd="'${DIARIZATION_PYTHON}'"
    if ! has_arg --diarization && ! has_arg --no-diarization && ! has_arg --groq; then
      remote_args+=("--diarization")
    fi
  fi
  if ((${#remote_args[@]} > 0)); then
    printf -v escaped_args ' %q' "${remote_args[@]}"
  fi
  ssh -q "$REMOTE" "${MISE_INIT}; mkdir -p ~/.cache; cd ${TRANSCRIBE_DIR} && PYTHONUNBUFFERED=1 flock ~/.cache/heyma-transcribe.lock ${runner_cmd} scripts/transcribe.py '${REMOTE_FILE}' --progress-file '${REMOTE_LOG}'${escaped_args}"
}

# Print "YYYY-MM-DD/HHMMSS-<basename>" key for s3 archive of $1, using mtime.
s3_key_for() {
  local path="$1" ft date_str time_str
  ft="$(stat -c %Y -- "$path")"
  date_str="$(date -d "@${ft}" +%Y-%m-%d)"
  time_str="$(date -d "@${ft}" +%H%M%S)"
  printf '%s/%s-%s' "$date_str" "$time_str" "$(basename "$path")"
}

# Local, NON-SYNCED safety vault. The inbox is a receive-only Syncthing folder
# with file versioning DISABLED, so a remote peer's deletion (or a folder-marker
# reset) can erase a source recording with zero recovery. When S3 is unreachable
# we copy the source here so the audio is never the only-copy in a volatile dir.
# Must live OUTSIDE any synced folder.
STASH_DIR="${TRANSCRIBE_STASH_DIR:-${HOME}/audio/recovered}"

stash_local() {
  local src="$1" dest ft
  [[ -f "$src" ]] || return 0
  mkdir -p "$STASH_DIR" || { log "[warn] could not create stash dir $STASH_DIR"; return 0; }
  ft="$(stat -c %Y -- "$src" 2>/dev/null || echo 0)"
  dest="${STASH_DIR}/$(date -d "@${ft}" +%Y%m%d-%H%M%S)-$(basename "$src")"
  if [[ -e "$dest" ]]; then
    log "[stash] Safety copy already present: $dest"
  elif cp -n -- "$src" "$dest"; then
    log "[stash] Safety copy preserved: $dest"
  else
    log "[warn] failed to stash safety copy of $src"
  fi
}

# Archive the source audio to S3 FIRST (called before transcription) and VERIFY
# it persisted. The source is NEVER deleted. On any failure, keep the source and
# drop a local safety copy. Returns 0 if the audio is durably stored (S3 verified
# OR local stash made), non-zero only if we could not secure it anywhere.
archive_to_s3() {
  local src="$1" key
  if [[ ! -x "$MC_BIN" ]]; then
    log "[error] --archive-s3 requested but $MC_BIN not found; keeping source + stashing copy."
    stash_local "$src"
    return 1
  fi
  key="$(s3_key_for "$src")"
  log "[s3] (backup-first) Uploading source -> ${S3_ALIAS}/${S3_BUCKET}/${key}"
  # VERIFY BY SIZE, NOT EXISTENCE. `mc stat` merely proves an object is there,
  # which is how s3://recordings/2026-07-22/172632-record_0016.mp3 sat at
  # 262,144 B while the local file was 950,785,004 B (16.5 h) and the pipeline
  # reported a successful backup. A truncated backup is worse than none,
  # because it stops you looking.
  local local_size remote_size
  local_size="$(stat -c %s -- "$src" 2>/dev/null || echo 0)"
  if "$MC_BIN" cp --quiet "$src" "${S3_ALIAS}/${S3_BUCKET}/${key}" >&2; then
    remote_size="$("$MC_BIN" stat --json "${S3_ALIAS}/${S3_BUCKET}/${key}" 2>/dev/null \
      | /usr/bin/python3 -c 'import json,sys;print(json.load(sys.stdin).get("size",0))' 2>/dev/null || echo 0)"
    if [[ -n "$local_size" && "$remote_size" == "$local_size" ]]; then
      log "[s3] Upload verified byte-for-byte (${local_size} B). Source preserved: $src"
      return 0
    fi
    log "[error] S3 size mismatch: remote=${remote_size} local=${local_size} — TRUNCATED UPLOAD."
  fi
  log "[error] S3 upload/verify FAILED; preserving source + stashing local safety copy."
  stash_local "$src"
  return 1
}

# ---- main: local path ----
if is_local; then
  # The log is the only forensic record of a failed transcription. Deleting it
  # unconditionally (the old `trap 'rm -f' EXIT`) is why every recurrence of
  # "transcription broke again" has been undiagnosable. Rules now:
  #   - a caller-supplied $TRANSCRIBE_LOG_FILE is NEVER deleted
  #   - a self-allocated temp log is deleted only on SUCCESS
  LOG_FILE="${TRANSCRIBE_LOG_FILE:-}"
  LOG_FILE_OWNED=false
  if [[ -z "$LOG_FILE" ]]; then
    LOG_FILE="$(mktemp /tmp/transcribe.XXXXXX.log)"
    LOG_FILE_OWNED=true
  else
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    : >"$LOG_FILE"
  fi
  trap '_rc=$?;
        if [[ $_rc -ne 0 ]]; then
          printf "[log] retained for diagnosis: %s\n" "$LOG_FILE" >&2
        elif [[ "$LOG_FILE_OWNED" == "true" ]]; then
          rm -f "$LOG_FILE"
        fi' EXIT

  # STEP 1 (PRIORITY): back up the source audio to S3 BEFORE transcribing.
  # The audio is the irreplaceable artifact; the transcript can always be
  # regenerated from it. We never delete the source.
  if [[ "$ARCHIVE_S3" == "true" ]]; then
    archive_to_s3 "$AUDIO" || log "[warn] backup did not reach S3; proceeding (source is preserved/stashed)."
  fi

  # Hard policy boundary. Archive first when requested, but never launch the
  # expensive transcription process for a file at or above the ceiling.
  enforce_transcription_size_limit
  enforce_transcription_duration_limit

  # SERIALIZE the heavy work: only ONE transcription may run at a time on this
  # host. Unbounded concurrency here once spiked load avg to 68 (4 parallel
  # transcribe.py jobs, 2026-07-20). The S3 backup (STEP 1) runs OUTSIDE this
  # lock so every incoming file is secured immediately; only the GPU/CPU-heavy
  # decode+diarization is queued. Blocking flock => files queue, never dropped.
  # The remote-ssh branch below locks the same host path, so local and remote
  # invocations mutually exclude on big-chungus.
  TRANSCRIBE_LOCK_FILE="${TRANSCRIBE_LOCK_FILE:-${HOME}/.cache/heyma-transcribe.lock}"
  mkdir -p "$(dirname "$TRANSCRIBE_LOCK_FILE")" 2>/dev/null || true
  exec 200>"$TRANSCRIBE_LOCK_FILE"
  if ! flock -n 200; then
    log "[lock] Another transcription holds the slot; waiting for it to finish..."
    flock 200
  fi
  log "[lock] Acquired transcription slot."

  # STEP 2: transcribe.
  # Stream stderr to log file AND to caller's stderr via tee. The `2>&1 1>/dev/null`
  # routes only stderr into the pipe; pipefail surfaces the upstream exit code.
  if { run_local_transcribe false 2>&1 1>/dev/null | tee "$LOG_FILE" >&2; }; then
    :
  else
    rc=$?
    if should_retry_on_cpu; then
      log "[warn] Transcription failed (exit $rc); retrying with --device cpu..."
      if { run_local_transcribe true 2>&1 1>/dev/null | tee -a "$LOG_FILE" >&2; }; then
        :
      else
        exit $?
      fi
    else
      exit $rc
    fi
  fi

  MD_PATH="$(awk '/^Written: / { sub(/^Written: /, ""); last=$0 } END { if (last) print last }' "$LOG_FILE")"
  if [[ -z "$MD_PATH" || ! -f "$MD_PATH" ]]; then
    log "[error] Transcription completed but no 'Written:' path produced."
    exit 1
  fi

  # The source audio is NEVER deleted. It stays in the inbox and (if --archive-s3)
  # is already safe in S3.
  printf '%s\n' "$MD_PATH"
  exit 0
fi

# ---- main: remote path ----
REMOTE_STAGING="/tmp/transcribe-staging"
FILENAME="$(basename "$AUDIO")"
REMOTE_FILE="${REMOTE_STAGING}/${FILENAME}"
REMOTE_LOG="${REMOTE_STAGING}/${FILENAME}.log"
TAIL_PID=""

cleanup() {
  [[ -n "$TAIL_PID" ]] && kill "$TAIL_PID" 2>/dev/null || true
  wait "$TAIL_PID" 2>/dev/null || true
  ssh -q "$REMOTE" "rm -f '${REMOTE_FILE}' '${REMOTE_LOG}'" 2>/dev/null || true
}
trap cleanup EXIT

log "[remote] Pushing ${FILENAME} to ${TRANSCRIBE_HOST}..."
ssh -q "$REMOTE" "mkdir -p ${REMOTE_STAGING}"
scp -q "$AUDIO" "${REMOTE}:${REMOTE_FILE}"
log "[remote] Upload complete."

# STEP 1 (PRIORITY): back up the source to S3 BEFORE transcribing, via the
# already-staged remote copy, and verify it landed. The source is never deleted.
if [[ "$ARCHIVE_S3" == "true" ]]; then
  KEY="$(s3_key_for "$AUDIO")"
  log "[s3] (backup-first) Uploading via remote mc -> ${S3_ALIAS}/${S3_BUCKET}/${KEY}"
  if ssh -q "$REMOTE" "${MC_BIN} cp --quiet '${REMOTE_FILE}' '${S3_ALIAS}/${S3_BUCKET}/${KEY}' && ${MC_BIN} stat '${S3_ALIAS}/${S3_BUCKET}/${KEY}' >/dev/null" >&2; then
    log "[s3] Upload verified. Local source preserved (never deleted): $AUDIO"
  else
    log "[error] S3 upload/verify FAILED; preserving source + stashing local safety copy."
    stash_local "$AUDIO"
  fi
fi

enforce_transcription_size_limit
enforce_transcription_duration_limit

log "[remote] Starting transcription..."
ssh -q "$REMOTE" "truncate -s 0 '${REMOTE_LOG}'"
ssh -q "$REMOTE" "tail -f '${REMOTE_LOG}'" >&2 &
TAIL_PID=$!

if run_remote_transcribe false; then
  TRANSCRIBE_EXIT=0
else
  TRANSCRIBE_EXIT=$?
  if should_retry_on_cpu; then
    log "[warn] Remote transcription failed (exit $TRANSCRIBE_EXIT); retrying with --device cpu..."
    ssh -q "$REMOTE" "truncate -s 0 '${REMOTE_LOG}'"
    if run_remote_transcribe true; then
      TRANSCRIBE_EXIT=0
    else
      TRANSCRIBE_EXIT=$?
    fi
  fi
fi

sleep 1
kill "$TAIL_PID" 2>/dev/null || true
wait "$TAIL_PID" 2>/dev/null || true
TAIL_PID=""

if [[ $TRANSCRIBE_EXIT -ne 0 ]]; then
  log "[error] Transcription failed (exit $TRANSCRIBE_EXIT)"
  exit 1
fi

REMOTE_MD=$(ssh -q "$REMOTE" "grep '^Written:' '${REMOTE_LOG}' | tail -n1 | sed 's/^Written: //'")
if [[ -z "$REMOTE_MD" ]]; then
  log "[error] No output file produced"
  exit 1
fi

LOCAL_DIR="${TRANSCRIPTS:-${HOME}/d/Notes/Transcripts}"
mkdir -p "$LOCAL_DIR"
LOCAL_MD="${LOCAL_DIR}/$(basename "$REMOTE_MD")"
scp -q "${REMOTE}:${REMOTE_MD}" "$LOCAL_MD"
log "[remote] Downloaded: ${LOCAL_MD}"

# Source audio was already backed up to S3 before transcription (STEP 1 above)
# and is NEVER deleted.
printf '%s\n' "$LOCAL_MD"
