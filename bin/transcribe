#!/usr/bin/env bash
# Batch transcribe an audio file to markdown
# Usage: transcribe /path/to/file.mp3 [options]
#
# If run on a machine that isn't the transcription host, the file is pushed
# to the host via scp, transcribed remotely, and the markdown is pulled back.
# Progress is shown via tail -f on a remote log file.
set -euo pipefail

TRANSCRIBE_HOST="${TRANSCRIBE_HOST:-192.168.1.12}"
TRANSCRIBE_USER="${TRANSCRIBE_USER:-delorenj}"
TRANSCRIBE_DIR="/home/delorenj/code/33GOD/HeyMa"
REMOTE="${TRANSCRIBE_USER}@${TRANSCRIBE_HOST}"
MISE_INIT='source ~/.profile 2>/dev/null; eval "$(mise activate bash)" 2>/dev/null'
DIARIZATION_VENV="${DIARIZATION_VENV:-${TRANSCRIBE_DIR}/.venv-diarization}"
DIARIZATION_PYTHON="${DIARIZATION_PYTHON:-${DIARIZATION_VENV}/bin/python}"

AUDIO="${1:?Usage: transcribe <audio-file> [options]}"
shift
EXTRA_ARGS=("$@")

AUDIO="$(realpath "$AUDIO")"

TRANSCRIBE_HOSTNAME="${TRANSCRIBE_HOSTNAME:-big-chungus}"

is_local() {
    [[ "$(hostname)" == "${TRANSCRIBE_HOSTNAME}" ]]
}

has_explicit_device_arg() {
    local arg
    for arg in "${EXTRA_ARGS[@]}"; do
        [[ "$arg" == "--device" || "$arg" == --device=* ]] && return 0
    done
    return 1
}

has_groq_arg() {
    local arg
    for arg in "${EXTRA_ARGS[@]}"; do
        [[ "$arg" == "--groq" ]] && return 0
    done
    return 1
}

has_diarization_arg() {
    local arg
    for arg in "${EXTRA_ARGS[@]}"; do
        [[ "$arg" == "--diarization" ]] && return 0
    done
    return 1
}

should_retry_on_cpu() {
    if has_explicit_device_arg || has_groq_arg; then
        return 1
    fi
    return 0
}

run_local_transcribe() {
    local force_cpu="${1:-false}"
    local -a cmd_args
    local -a runner_cmd
    cmd_args=("$AUDIO" "${EXTRA_ARGS[@]}")
    if [[ "$force_cpu" == "true" ]]; then
        cmd_args+=("--device" "cpu")
    fi

    if has_diarization_arg; then
        if [[ -x "$DIARIZATION_PYTHON" ]]; then
            runner_cmd=("$DIARIZATION_PYTHON")
        else
            echo "[warn] --diarization requested but ${DIARIZATION_PYTHON} is missing; using default uv environment." >&2
            runner_cmd=(uv run python)
        fi
    else
        runner_cmd=(uv run python)
    fi

    "${runner_cmd[@]}" scripts/transcribe.py "${cmd_args[@]}"
}

run_remote_transcribe() {
    local force_cpu="${1:-false}"
    local -a remote_args
    local escaped_args=""
    local runner_cmd="uv run python"
    remote_args=("${EXTRA_ARGS[@]}")
    if [[ "$force_cpu" == "true" ]]; then
        remote_args+=("--device" "cpu")
    fi
    if ((${#remote_args[@]} > 0)); then
        printf -v escaped_args ' %q' "${remote_args[@]}"
    fi
    if has_diarization_arg; then
        if ssh -q "$REMOTE" "test -x '${DIARIZATION_PYTHON}'"; then
            runner_cmd="'${DIARIZATION_PYTHON}'"
        else
            echo "[warn] --diarization requested but ${DIARIZATION_PYTHON} is missing on remote; using default uv environment." >&2
        fi
    fi
    ssh -q "$REMOTE" "${MISE_INIT}; cd ${TRANSCRIBE_DIR} && PYTHONUNBUFFERED=1 ${runner_cmd} scripts/transcribe.py '${REMOTE_FILE}' --progress-file '${REMOTE_LOG}'${escaped_args}"
}

if is_local; then
    cd "$TRANSCRIBE_DIR"
    if run_local_transcribe; then
        exit 0
    fi
    if should_retry_on_cpu; then
        echo "[warn] Transcription failed in auto mode; retrying with --device cpu..." >&2
        run_local_transcribe true
        exit $?
    fi
    exit 1
fi

# --- Remote execution ---
REMOTE_STAGING="/tmp/transcribe-staging"
FILENAME="$(basename "$AUDIO")"
REMOTE_FILE="${REMOTE_STAGING}/${FILENAME}"
REMOTE_LOG="${REMOTE_STAGING}/${FILENAME}.log"
TAIL_PID=""

cleanup() {
    # Kill the tail process if it's still running
    [[ -n "$TAIL_PID" ]] && kill "$TAIL_PID" 2>/dev/null || true
    wait "$TAIL_PID" 2>/dev/null || true
    # Clean up remote staging
    ssh -q "$REMOTE" "rm -f '${REMOTE_FILE}' '${REMOTE_LOG}'" 2>/dev/null || true
}
trap cleanup EXIT

# 1. Push file
echo "[remote] Pushing ${FILENAME} to ${TRANSCRIBE_HOST}..." >&2
ssh -q "$REMOTE" "mkdir -p ${REMOTE_STAGING}"
scp -q "$AUDIO" "${REMOTE}:${REMOTE_FILE}"
echo "[remote] Upload complete. Starting transcription..." >&2

# 2. Create empty log file, then start tailing it in the background
ssh -q "$REMOTE" "truncate -s 0 '${REMOTE_LOG}'"
ssh -q "$REMOTE" "tail -f '${REMOTE_LOG}'" &
TAIL_PID=$!

# 3. Run transcription (blocks until done)
if run_remote_transcribe; then
    TRANSCRIBE_EXIT=0
else
    TRANSCRIBE_EXIT=$?
    if should_retry_on_cpu; then
        echo "[warn] Remote transcription failed in auto mode; retrying with --device cpu..." >&2
        ssh -q "$REMOTE" "truncate -s 0 '${REMOTE_LOG}'"
        if run_remote_transcribe true; then
            TRANSCRIBE_EXIT=0
        else
            TRANSCRIBE_EXIT=$?
        fi
    fi
fi

# 4. Give tail a moment to catch up, then kill it
sleep 1
kill "$TAIL_PID" 2>/dev/null || true
wait "$TAIL_PID" 2>/dev/null || true
TAIL_PID=""

if [[ $TRANSCRIBE_EXIT -ne 0 ]]; then
    echo "[error] Transcription failed (exit $TRANSCRIBE_EXIT)" >&2
    exit 1
fi

# 5. Parse the "Written:" line from the remote log
REMOTE_MD=$(ssh -q "$REMOTE" "grep '^Written:' '${REMOTE_LOG}'" | sed 's/Written: //')

if [[ -n "$REMOTE_MD" ]]; then
    LOCAL_DIR="${HOME}/d/Transcripts"
    mkdir -p "$LOCAL_DIR"
    LOCAL_MD="${LOCAL_DIR}/$(basename "$REMOTE_MD")"

    scp -q "${REMOTE}:${REMOTE_MD}" "$LOCAL_MD"
    echo "[local] Downloaded: ${LOCAL_MD}" >&2
else
    echo "[error] No output file produced" >&2
    exit 1
fi
