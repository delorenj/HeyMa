#!/usr/bin/env python3
"""Self-locating, local-only Telephony CLI."""
from pathlib import Path
import os
import sys

argv = [arg for arg in sys.argv[1:] if arg != "--json"]
if argv and argv[0] in ("alert-mode", "alert"):
    from subprocess import run
    service = Path.home() / "code/33GOD/bloodbank/services/target-watch"
    if not (service / "target_watch" / "alert_cli.py").is_file():
        print('{"error":"canonical target-watch unavailable"}', file=sys.stderr)
        raise SystemExit(2)
    env = os.environ.copy()
    env["PYTHONPATH"] = str(service)
    raise SystemExit(run([sys.executable, "-m", "target_watch.alert_cli", *argv[1:]], env=env, check=False).returncode)

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "components" / "telephony" / "src"))
from telephony.core import main

if __name__ == "__main__":
    raise SystemExit(main())
