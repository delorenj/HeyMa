def config_rows(denv: dict[str, str], uenv: dict[str, str],
                yenv: dict[str, tuple[str, str]], daemon_running: bool) -> list[dict[str, Any]]:
    """One row per variable Wax reads, with the SOURCE that actually won."""
    rows = []
    for name, consumer, default in ENV_SPECS:
        note = ""
        if name in yenv:
            slug, value = yenv[name]
            source = f"pass yaml ({slug})"
        elif name in uenv:
            value, source = uenv[name], "systemd unit"
        elif name in denv:
            value, source = denv[name], "daemon env (inherited)"
        elif name in os.environ:
            # Deliberately NOT called "environment": a shell export is invisible
            # to the user unit, and treating it as the answer is how a probe
            # passes here and fails in the daemon.
            value = os.environ[name]
            source = "this shell only" if daemon_running else "environment"
            note = "waxd does NOT have this" if daemon_running else ""
        else:
            value, source = default, "default"
        if name in yenv and name in uenv and uenv[name] != yenv[name][1]:
            note = f"unit sets {_redact(name, uenv[name])}; the pass yaml overrides it"
        elif source == "systemd unit" and daemon_running and denv.get(name) != value:
            # The unit on disk is not what the running process has. A unit edited
            # after the daemon started reads as applied in every tool that asks
            # systemd — and is not applied at all in the process doing the work.
            note = ("the RUNNING daemon does NOT have this — the unit was edited "
                    "since it started; systemctl --user restart waxd to apply")
        rows.append({"name": name, "value": _redact(name, value, is_default=source == "default"),
                     "source": source, "consumer": consumer, "note": note})
    return rows


def _probe(name: str, status: str, detail: str, fix: str = "") -> dict[str, Any]:
    return {"probe": name, "status": status, "detail": detail, **({"fix": fix} if fix else {})}


def _resolve_transcriber(denv: dict[str, str]) -> tuple[Optional[Path], str]:
    """Resolve WAX_TRANSCRIBE the way transcribe_adapter does, but against the
    DAEMON's environment rather than this shell's — the daemon is what runs it."""
    configured = (denv.get("WAX_TRANSCRIBE") or "").strip()
    if configured:
        return Path(configured).expanduser(), "WAX_TRANSCRIBE"
    found = shutil.which("transcribe")
    return (Path(found), "PATH") if found else (None, "unresolved")


def _op_read(reference: str) -> str:
    """Resolve one op:// reference, or "" — the same order title-slug uses.

    The value is returned so the model probe can actually call the provider, and
    it is never rendered: doctor prints WHICH field answered, never what it said.
    """
    if not reference:
        return ""
    rc, out, _ = _run(["op", "read", reference], timeout=10)
    return out.strip() if rc == 0 else ""


def _get_json(url: str, *, token: str) -> tuple[Optional[Any], str]:
    request = urllib.request.Request(url, headers={"Authorization": f"Bearer {token}",
                                                  "User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_S) as response:
            return json.loads(response.read().decode("utf-8", "replace")), ""
    except urllib.error.HTTPError as e:
        # HTTPError BEFORE URLError, always: it is a subclass, and catching the
        # parent first is the exact mistake that discarded the response body
        # naming the deleted model for five days.
        try:
            body = e.read().decode("utf-8", "replace")[:200]
        except (OSError, ValueError):
            body = ""
        return None, f"HTTP {e.code}: {body or e.reason}"
    except (urllib.error.URLError, OSError, ValueError, json.JSONDecodeError) as e:
        return None, f"{type(e).__name__}: {e}"


def _chat_probe(api_base: str, token: str, model: str) -> tuple[Optional[Any], str, int]:
    """One 1-token chat request: (body, error, status). status 0 means unreachable."""
    body = json.dumps({"model": model, "max_tokens": 1,
                       "messages": [{"role": "user", "content": "ok"}]}).encode()
    request = urllib.request.Request(
        f"{api_base}/chat/completions", data=body, method="POST",
        headers={"Authorization": f"Bearer {token}", "User-Agent": USER_AGENT,
                 "Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(request, timeout=HTTP_TIMEOUT_S) as response:
            return None, "", response.status
    except urllib.error.HTTPError as e:
        return None, f"HTTP {e.code}", e.code
    except (urllib.error.URLError, OSError, ValueError) as e:
        return None, f"{type(e).__name__}: {e}", 0


def _chain_serves(api_base: str, token: str, chain: list[str]) -> dict[str, Any]:
    """Walk the chain with 1-token requests, as a pass would, until a member serves.

    Listing is not serving: on 2026-10-22 every member was listed for the token
    and every one but the explicit GLM routes answered 503. This row says which
    member a pass would land on right now and what the gateway says served it.
    """
    url = f"{api_base}/chat/completions"
    failed: list[str] = []
    for index, member in enumerate(chain):
        headers: dict[str, str] = {}
        try:
            body = provider.post_json(url, {"model": member, "max_tokens": 1,
                                            "messages": [{"role": "user", "content": "ok"}]},
                                      key=token, timeout=HTTP_TIMEOUT_S, response_headers=headers)
        except provider.ProviderError as exc:
            route = f"->{exc.route}" if exc.route and exc.route != member else ""
            failed.append(f"{member}={exc.status or exc.reason_code}{route}")
            if not provider.falls_through(exc):
                break
            continue
        served = provider.provenance_of(body, headers)
        banned = provider.anthropic_in(served)
        origin = ", ".join(f"{k} {v}" for k, v in served.items() if k != "auto") or "no served_by reported"
        before = f" after {'; '.join(failed)}" if failed else ""
        if banned:
            return _probe("inference chain serves", FAIL,
                          f"{member} was served by an Anthropic model ({banned}){before}",
                          "python3 deploy/provision-inference --apply   # then report the router to token-ops")
        return _probe("inference chain serves", PASS if index == 0 else WARN,
                      f"{member} serves ({origin}){before}",
                      "" if index == 0 else
                      "the chain is falling through gateway-side failures; report them to token-ops")
    return _probe("inference chain serves", FAIL, "no member served: " + "; ".join(failed),
                  "gateway-side: report to token-ops; passes will fail and the sweep retries them")


def _get_json_direct(url: str, *, timeout: float = PJ_TIMEOUT_S) -> tuple[Optional[Any], str]:
    """GET a loopback JSON endpoint with the environment's proxies IGNORED.

    A shell exporting http_proxy would otherwise send 127.0.0.1 through it and
    report the registry down while it is answering locally.
    """
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(urllib.request.Request(url, headers={"Accept": "application/json"}),
                         timeout=timeout) as response:
            return json.loads(response.read().decode("utf-8", "replace")), ""
    except urllib.error.HTTPError as e:
        return None, f"HTTP {e.code}"
    except (urllib.error.URLError, OSError, ValueError) as e:
        return None, f"{type(e).__name__}: {e}"


def _heyma_project_id(repo: Path) -> str:
    try:
        return str(json.loads((repo / ".project.json").read_text()).get("project_id") or HEYMA_PROJECT_ID)
    except (OSError, ValueError, AttributeError):
        return HEYMA_PROJECT_ID


def probe_project_extraction(add, *, repo: Path, effective: dict[str, str],
                             yenv: dict[str, tuple[str, str]]) -> None:
    """Probes for what project-extraction and ticketable cannot work without.

    Both fail by returning nothing (an unreachable registry gives an empty
    candidate list, a dead Jev key gives no answers), which is exactly the shape
    of every earlier silent outage -- so each dependency gets its own probe.
    Severity follows whether the pass is actually enabled: a registry that is
    down while nothing uses it is news, not an emergency.
    """
    ep = passes.registry().get("project-extraction")
    enabled = bool(ep and ep.get("enabled"))
    bad = FAIL if enabled else WARN
    unused = "" if enabled else " (project-extraction is not enabled)"

    def setting(name: str, default: str) -> str:
        pass_env = (ep or {}).get("env") or {}
        value = pass_env[name] if name in pass_env else (yenv[name][1] if name in yenv
                                                         else effective.get(name) or default)
        return str(value).strip() or default

    # -- pjangler registry ----------------------------------------------------
    # Same precedence as pjangler's own client and wax.pjregistry.registry_url().
    base = (setting("PJ_PROJECT_REGISTRY", "") or setting("PJ_REGISTRY_URL", PJ_REGISTRY_DEFAULT)).rstrip("/")
    project_id = _heyma_project_id(repo)
    fix = ("curl -X POST -H content-type:application/json "
           f"-d '{json.dumps({'manifest_path': str(repo / '.project.json')}, separators=(',', ':'))}' "
           f"{base}/v1/index")
    health = err = None
    if not base.lower().startswith(("http://", "https://")):
        # `pj` treats a non-HTTP value as a YAML fixture path; Wax cannot read one.
        add(_probe("pjangler registry", bad, f"registry location {base!r} is not an HTTP URL{unused}",
                   "unset PJ_PROJECT_REGISTRY / PJ_REGISTRY_URL in waxd.service"))
    else:
        health, err = _get_json_direct(f"{base}/health")
    if health is None and err is not None:
        add(_probe("pjangler registry", bad, f"{base}/health: {err}{unused}",
                   "systemctl --user start pjangler-project-registry.service"))
    elif health is not None:
        snapshot, err = _get_json_direct(f"{base}/v1/registry")
        known = snapshot.get("projects") if isinstance(snapshot, dict) else None
        if not isinstance(known, dict):
            add(_probe("pjangler registry", bad, f"{base}/v1/registry: {err or 'no projects object'}{unused}",
                       "systemctl --user restart pjangler-project-registry.service"))
        elif project_id not in known:
            add(_probe("pjangler registry", bad,
                       f"{base} is up with {len(known)} project(s) but {project_id!r} (HeyMa) is NOT "
                       f"registered, so tickets for this repo cannot be attributed{unused}", fix))
        else:
            status = ((snapshot.get("__registry_status") or {}).get(project_id) or {}).get("status")
            if status not in (None, "ok"):
                add(_probe("pjangler registry", bad,
                           f"{project_id!r} is registered but its index status is {status!r}{unused}", fix))
            else:
                add(_probe("pjangler registry", PASS, f"{base}: {len(known)} project(s), {project_id!r} present"))

    # -- Jev ingress + virtual key --------------------------------------------
    # Probed while the pass is disabled too (as WARN), so a re-enable is never
    # the first time anyone learns the key or the ingress is broken. Both
    # probes are free: no decision is requested.
    if ep is None:
        return
    url = setting("WAX_JEV_URL", JEV_URL_DEFAULT)
    parsed = urllib.parse.urlsplit(url)
    if "openrouter.ai" in parsed.netloc.lower() or parsed.scheme not in ("http", "https"):
        add(_probe("jev ingress", bad, f"WAX_JEV_URL={url} is not the Jev ingress{unused}",
                   f"set WAX_JEV_URL to {JEV_URL_DEFAULT}; OpenRouter's decisions proxy is retired"))
        return
    model = setting("WAX_JEV_MODEL", JEV_MODEL_DEFAULT)
    if model.lower().startswith("typesafe/"):
        add(_probe("jev ingress", bad, f"WAX_JEV_MODEL={model} is OpenRouter's spelling; System One 400s it{unused}",
                   f"set WAX_JEV_MODEL to {JEV_MODEL_DEFAULT}"))
        return
    origin = f"{parsed.scheme}://{parsed.netloc}"
    # Resolution order is the pass's own (wax.provider.resolve_key): a literal
    # $WAX_JEV_API_KEY wins over the op:// reference.
    reference = setting("WAX_JEV_API_KEY_OP", JEV_KEY_OP_DEFAULT)
    literal = setting("WAX_JEV_API_KEY", "")
    where = "WAX_JEV_API_KEY (a literal key in the environment)" if literal else reference
    key = literal or _op_read(reference)
    if not key:
        add(_probe("jev api key", bad, f"{reference} did not resolve{unused}",
                   f"op read {reference}   # then fix vault access or the field itself"))
        return
    # The pass-through answering at all proves the route exists (LiteLLM
    # 1.94.0 has none: a bare 404) and that the ingress holds a working
    # TypeSafe credential.
    models, err = _get_json(f"{origin}/typesafe/v1/models", token=key)
    listed = models.get("models") if isinstance(models, dict) else None
    if not isinstance(listed, list) or not listed:
        add(_probe("jev ingress", bad, f"{origin}/typesafe/v1/models: {err or 'no models listed'}{unused}",
                   "cd ~/docker/stacks/ai/jev-litellm && mise run up && mise run probe"))
    else:
        add(_probe("jev ingress", PASS, f"{origin}: TypeSafe pass-through answers ({len(listed)} model alias(es))"))
    payload, err = _get_json(f"{origin}/key/info", token=key)
    info = payload.get("info") if isinstance(payload, dict) else None
    if not isinstance(info, dict):
        if err.startswith("HTTP 404"):
            # The master key authenticates but is not a row in the key table.
            detail = f"{where} is not a virtual key (the ingress master key?)"
        elif err.startswith(("HTTP 401", "HTTP 403")):
            detail = f"{where} was rejected by {origin} ({err.split(':')[0]})"
        else:
            detail = f"{origin}/key/info: {err or 'no info object'}"
        add(_probe("jev api key", bad, detail + unused,
                   "mint a HeyMa virtual key on jev-litellm (/key/generate with the master key), "
                   "store it in 1Password and point WAX_JEV_API_KEY_OP at it"))
        return
    alias = info.get("key_alias") or "<no alias>"
    spend, budget = info.get("spend"), info.get("max_budget")
    if info.get("blocked"):
        add(_probe("jev api key", bad, f"{where} ({alias}) is blocked on the ingress{unused}",
                   "unblock it: POST /key/unblock on jev-litellm"))
        return
    if isinstance(budget, (int, float)) and isinstance(spend, (int, float)) and spend >= budget:
        add(_probe("jev api key", bad,
                   f"{where} ({alias}) has spent its budget ({spend:.6f}/{budget:g} USD){unused}",
                   f"wait for the reset at {info.get('budget_reset_at') or '?'} or raise max_budget"))
        return
    detail = (f"{where}: virtual key {alias}, "
              + ("no budget cap" if budget is None
                 else f"spend {float(spend or 0):.6f}/{budget:g} USD per {info.get('budget_duration') or 'lifetime'}"))
    if literal:
        add(_probe("jev api key", WARN, detail + "; a literal key, not 1Password",
                   f"move it into {reference} and drop WAX_JEV_API_KEY"))
    else:
        add(_probe("jev api key", PASS, detail))


def pending_pass_event_report() -> list[tuple[str, str, int]]:
    """(item_id, slug, count) for completed passes whose declared events were never enqueued.

    Only FINALIZED items are examined: for an unfinalized one the events are
    simply not due yet and finalize() will enqueue them with the completion.
    """
    conn = ledger.connect()
    emitted = {row["event_id"] for row in conn.execute("SELECT event_id FROM pass_events")}
    out = []
    for row in conn.execute(
            "SELECT p.item_id, p.ep_slug, p.result FROM passes p "
            "WHERE p.state='completed' AND p.result LIKE '%\"events\"%' "
            "AND p.item_id IN (SELECT item_id FROM completions) ORDER BY p.item_id, p.ep_slug"):
        missing = sum(1 for event in finalize.declared_events(row["result"])
                      if finalize.pass_event_id(row["item_id"], row["ep_slug"],
                                                event["type"], event["key"]) not in emitted)
        if missing:
            out.append((row["item_id"], row["ep_slug"], missing))
    return out


def probe_all() -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    add = out.append
    repo = _repo_root()
    pid = waxd_pid()
    denv = proc_env(pid)
    # No daemon means no daemon environment; fall back to this process so the
    # probes still answer, and say so rather than pretending otherwise.
    effective = denv or dict(os.environ)

    # -- daemon ----------------------------------------------------------
    if pid is None:
        add(_probe("waxd running", FAIL, "no live process matched waxd",
                   "systemctl --user start waxd"))
    else:
        rc, out_s, _ = _run(["systemctl", "--user", "is-active", "waxd.service"], timeout=10)
        add(_probe("waxd running", PASS, f"pid {pid}, unit {out_s.strip() or 'unknown'}"))

    try:
        age = time.time() - paths.STATE_JSON.stat().st_mtime
        add(_probe("state mirror fresh", PASS if age < MIRROR_MAX_AGE_S else FAIL,
                   f"{paths.STATE_JSON} written {int(age)}s ago (limit {MIRROR_MAX_AGE_S}s)",
                   "" if age < MIRROR_MAX_AGE_S else "systemctl --user restart waxd"))
    except OSError as e:
        add(_probe("state mirror fresh", FAIL, f"{paths.STATE_JSON}: {e}",
                   "systemctl --user restart waxd"))

    # -- the ledger the daemon actually holds open ------------------------
    # Never inferred from a path. A stale ~/audio/var/wax.db sent one whole
    # investigation to the wrong database, so the answer comes from /proc/<pid>/fd.
    expected = paths.DB.resolve()
    if pid is None:
        add(_probe("ledger open by daemon", WARN,
                   f"waxd not running; this CLI would use {expected}"))
    else:
        held: set[Path] = set()
        unreadable = ""
        try:
            for fd in Path(f"/proc/{pid}/fd").iterdir():
                try:
                    target = Path(os.readlink(fd))
                except OSError:
                    continue
                if target.suffix == ".db":
                    held.add(target)
        except OSError as e:
            unreadable = str(e)
        if unreadable:
            add(_probe("ledger open by daemon", WARN, f"cannot read /proc/{pid}/fd: {unreadable}"))
        elif held == {expected}:
            add(_probe("ledger open by daemon", PASS, str(expected)))
        elif held:
            add(_probe("ledger open by daemon", FAIL,
                       f"daemon holds {sorted(str(p) for p in held)}, CLI resolves {expected}",
                       "align WAX_ROOT between the unit and your shell, then "
                       "systemctl --user restart waxd"))
        else:
            add(_probe("ledger open by daemon", WARN,
                       f"daemon holds no *.db fd yet; CLI resolves {expected}"))

    # -- unit vs. running process -----------------------------------------
    # `systemctl show` answers from the unit on DISK. A unit edited after the
    # daemon started therefore reports a configuration no running code has, and
    # every tool that asks systemd agrees with the lie.
    if pid is not None:
        uenv = unit_env()
        drift = sorted(k for k, v in uenv.items() if denv.get(k) != v)
        add(_probe("daemon env matches its unit", PASS if not drift else WARN,
                   "the running process has every Environment= the unit declares"
                   if not drift else
                   f"the unit declares {', '.join(drift)} but the running daemon does not have "
                   f"{'them' if len(drift) > 1 else 'it'}",
                   "" if not drift else "systemctl --user restart waxd"))

    # -- the transcriber, and which checkout it lives in -------------------
    transcriber, source = _resolve_transcriber(effective)
    if transcriber is None:
        add(_probe("transcriber resolves", FAIL, "neither WAX_TRANSCRIBE nor PATH names one",
                   f"systemctl --user set-environment is not enough — add "
                   f"Environment=WAX_TRANSCRIBE={repo / 'bin' / 'transcribe'} to waxd.service"))
    else:
        real = transcriber.expanduser()
        real = real.resolve() if real.exists() else real
        if not real.is_file() or not os.access(real, os.X_OK):
            add(_probe("transcriber resolves", FAIL, f"{source} -> {real} is not executable",
                       f"chmod +x {real}  (or repoint WAX_TRANSCRIBE at {repo / 'bin' / 'transcribe'})"))
        elif not real.is_relative_to(repo):
            # The two-checkout split: ~/.local/bin/transcribe pointed at a tree
            # 9 commits behind, so a reset in a repo nobody was editing disabled
            # diarization in the repo everybody was.
            add(_probe("transcriber inside deployed repo", FAIL,
                       f"{source} -> {real} is OUTSIDE {repo}",
                       f"set Environment=WAX_TRANSCRIBE={repo / 'bin' / 'transcribe'} in "
                       "waxd.service and restart"))
        else:
            add(_probe("transcriber inside deployed repo", PASS, f"{source} -> {real}"))

    # -- diarization, probed by importing what actually runs ---------------
    mode = transcribe_adapter.diarization_mode(effective)
    if mode == "disabled":
        add(_probe("diarization importable", WARN,
                   "WAX_DIARIZATION is falsy; diarization is switched OFF on purpose",
                   "unset WAX_DIARIZATION in waxd.service to restore it"))
    elif transcriber is None:
        add(_probe("diarization importable", FAIL, "no transcriber to locate a venv beside"))
    else:
        base = transcriber.expanduser()
        base = base.resolve() if base.exists() else base
        # Mirrors bin/transcribe exactly: TRANSCRIBE_DIR is the resolved script's
        # parent's parent (bin/transcribe -> <repo>), and the venv sits at that
        # repo root — NOT beside the script.
        transcribe_dir = Path(effective.get("TRANSCRIBE_DIR") or base.parent.parent)
        venv = Path(effective.get("DIARIZATION_VENV") or (transcribe_dir / ".venv-diarization"))
        python = Path(effective.get("DIARIZATION_PYTHON") or (venv / "bin" / "python"))
        fix = f"cd {repo} && mise run wax:diarization:install"
        if not python.is_file():
            add(_probe("diarization importable", FAIL, f"no interpreter at {python}", fix))
        else:
            started = time.time()
            wax_src = transcribe_dir / "components" / "wax" / "src"
            import_probe = (
                "import sys; "
                f"sys.path.insert(0, {str(wax_src)!r}); "
                "import librosa, nemo, wax.diarization_sortformer"
            )
            rc, _, err = _run(
                [str(python), "-c", import_probe],
                timeout=DIARIZATION_IMPORT_TIMEOUT_S,
            )
            took = round(time.time() - started, 1)
            if rc == 0:
                add(_probe("diarization importable", PASS,
                           f"tracked wax.diarization_sortformer via {python} ({took}s)"))
            else:
                last = [l for l in (err or "").strip().splitlines() if l.strip()]
                add(_probe("diarization importable", FAIL,
                           f"{python} rc={rc}: {last[-1] if last else 'no output'}", fix))

            try:
                device_policy = transcribe_adapter.diarization_device(effective)
            except transcribe_adapter.TranscribeError as exc:
                add(_probe("diarization device policy", FAIL, str(exc),
                           "set WAX_DIARIZATION_DEVICE=cuda in waxd.service and restart"))
                device_policy = "invalid"
            else:
                add(_probe(
                    "diarization device policy",
                    PASS if device_policy == "cuda" else WARN,
                    f"WAX_DIARIZATION_DEVICE={device_policy}"
                    + (" (strict GPU requirement)" if device_policy == "cuda" else
                       " (CPU use is possible; cuda is the production default)"),
                    "set WAX_DIARIZATION_DEVICE=cuda in waxd.service and restart"
                    if device_policy != "cuda" else "",
                ))

            if device_policy in {"cuda", "auto"}:
                cuda_probe = (
                    "import json, sys; "
                    f"sys.path.insert(0, {str(wax_src)!r}); "
                    "from wax.diarization_sortformer import cuda_smoke; "
                    "print(json.dumps(cuda_smoke(), sort_keys=True))"
                )
                rc, cuda_out, cuda_err = _run(
                    [str(python), "-c", cuda_probe],
                    timeout=DIARIZATION_IMPORT_TIMEOUT_S,
                )
                if rc == 0:
                    lines = [line for line in cuda_out.splitlines() if line.strip()]
                    add(_probe("diarization cuda runtime", PASS,
                               lines[-1] if lines else "CUDA smoke passed"))
                else:
                    last = [l for l in (cuda_err or "").strip().splitlines() if l.strip()]
                    add(_probe(
                        "diarization cuda runtime", FAIL,
                        f"{python} rc={rc}: {last[-1] if last else 'no output'}",
                        fix,
                    ))
            elif device_policy == "cpu":
                add(_probe("diarization cuda runtime", WARN,
                           "not exercised because WAX_DIARIZATION_DEVICE=cpu"))

    # -- title-slug provider ----------------------------------------------
    yenv = yaml_env()

    def _title(name: str, default: str) -> str:
        return (yenv[name][1] if name in yenv else effective.get(name) or default).strip()

    api_base = _title("WAX_TITLE_API_BASE", TITLE_API_BASE_DEFAULT).rstrip("/")
    model = _title("WAX_TITLE_MODEL", TITLE_MODEL_DEFAULT)
    primary = _title("WAX_TITLE_API_KEY_OP", TITLE_KEY_OP_DEFAULT)
    # Resolution order is title-slug's own: a literal $WAX_TITLE_API_KEY, else
    # the dedicated gateway token. There is no fallback reference and no
    # ambient provider key.
    key_source = ""
    key = (effective.get("WAX_TITLE_API_KEY") or "").strip()
    if key:
        key_source = "WAX_TITLE_API_KEY (a literal key in the environment)"
        add(_probe("title-slug api key", WARN,
                   "resolved from a literal env value, not 1Password",
                   f"move it into {primary} and drop WAX_TITLE_API_KEY"))
    else:
        key = _op_read(primary)
        if key:
            key_source = primary
            add(_probe("title-slug api key", PASS, f"resolved from {primary}"))
        else:
            add(_probe("title-slug api key", FAIL,
                       f"{primary} did not resolve"
                       + ("" if effective.get("OP_SERVICE_ACCOUNT_TOKEN")
                          else "; OP_SERVICE_ACCOUNT_TOKEN is absent from the daemon "
                               "environment, so `op read` cannot work unattended"),
                       f"op read {primary}   # then fix vault access or the field itself"))

    if not key:
        add(_probe("title-slug model served", FAIL,
                   f"cannot query {api_base}/models without a key"))
    else:
        payload, err = _get_json(f"{api_base}/models", token=key)
        if payload is None:
            add(_probe("title-slug model served", FAIL, f"{api_base}/models: {err}",
                       f"curl -H 'Authorization: Bearer $KEY' {api_base}/models"))
        else:
            entries = payload.get("data") if isinstance(payload, dict) else None
            ids = {str(e.get("id")) for e in (entries or []) if isinstance(e, dict)}
            # Same matching rule as title-slug's preflight_model(): OpenRouter
            # serves routing suffixes (:nitro, :floor) that never appear in the
            # catalog, so a bare-id match counts.
            row = next((e for e in entries or [] if isinstance(e, dict) and e.get("id") == model), {})
            is_auto = bool((row.get("automaticai") or {}).get("auto")) if isinstance(row, dict) else False
            members = sorted(i for i in ids if i != model and not i.startswith("automaticai/auto"))
            if is_auto and not members:
                # The listing is the token's scope. The router intersects its
                # pool with that scope, so an auto row with no member route
                # left is a 403 waiting to happen.
                add(_probe("title-slug model served", FAIL,
                           f"{model} is listed but the token is scoped to no member route it can land on "
                           f"(key from {key_source})",
                           "python3 ~/docker/stacks/ai/newapi/ops/gateway-tokens.py scope heyma-wax-inference "
                           "--models <auto name + member routes>   # see components/wax/deploy/provision-inference"))
            elif model in ids or model.split(":", 1)[0] in ids:
                add(_probe("title-slug model served", PASS,
                           f"{model} served to this token at {api_base}"
                           + (f" (auto route; {len(members)} scoped member route(s): {', '.join(members)})"
                              if is_auto else f" among {len(ids)} models")
                           + f" (key from {key_source})"))
            else:
                add(_probe("title-slug model served", FAIL,
                           f"{model!r} is NOT among the {len(ids)} models served by {api_base} "
                           f"(key from {key_source}) "
                           "— this is the exact shape of the 2026-08-15 outage",
                           f"set WAX_TITLE_MODEL in config/passes.d/title-slug.yaml to a model "
                           f"{api_base} actually serves"))

    # -- inference model chain ------------------------------------------------
    fallbacks_raw = _title("WAX_TITLE_MODEL_FALLBACKS", TITLE_MODEL_FALLBACKS_DEFAULT)
    chain = list(dict.fromkeys(m.strip() for m in [model, *fallbacks_raw.split(",")] if m.strip()))
    tickets_primary = (yenv["WAX_TICKETS_MODEL"][1] if "WAX_TICKETS_MODEL" in yenv else TITLE_MODEL_DEFAULT).strip()
    tickets_fallbacks = (yenv["WAX_TICKETS_MODEL_FALLBACKS"][1] if "WAX_TICKETS_MODEL_FALLBACKS" in yenv
                         else TITLE_MODEL_FALLBACKS_DEFAULT)
    tickets_chain = list(dict.fromkeys(m.strip() for m in [tickets_primary, *tickets_fallbacks.split(",")]
                                       if m.strip()))
    banned = [m for m in dict.fromkeys([*chain, *tickets_chain]) if ANTHROPIC_RE.search(m)]
    add(_probe("inference chain", FAIL if banned else PASS,
               ("Anthropic model(s) in the chain: " + ", ".join(banned)) if banned
               else " -> ".join(chain),
               "remove them from WAX_TITLE_MODEL / WAX_TITLE_MODEL_FALLBACKS in the pass yaml "
               "(operator order 2026-10-22: no Anthropic models)" if banned else ""))
    add(_probe("ticketable chain", PASS if tickets_chain == chain else WARN,
               " -> ".join(tickets_chain) + ("" if tickets_chain == chain else "  (differs from the title chain)")))
    if key:
        listing, err = _get_json(f"{api_base}/models", token=key)
        seen_entries = listing.get("data") if isinstance(listing, dict) else None
        seen = {str(e.get("id")) for e in (seen_entries or []) if isinstance(e, dict)}
        if not seen:
            add(_probe("inference chain visible", FAIL, f"{api_base}/models: {err or 'listed no models'}",
                       f"curl -H 'User-Agent: {USER_AGENT}' -H 'Authorization: Bearer $KEY' {api_base}/models"))
        else:
            for index, member in enumerate(chain):
                role = "primary" if index == 0 else f"fallback {index}"
                if member in provider.VIRTUAL_MODELS and member not in seen:
                    # A granted router family is not listed; only a request can
                    # tell "not granted" (403) from "granted but not serving".
                    _, _, probe_status = _chat_probe(api_base, key, member)
                    if probe_status == 200:
                        add(_probe(f"inference {role}", PASS,
                                   f"{member} answered a 1-token request (virtual family; /models never lists it)"))
                    elif probe_status == 403:
                        add(_probe(f"inference {role}", FAIL if index == 0 else WARN,
                                   f"{member} is NOT granted to this token (HTTP 403)",
                                   "python3 deploy/provision-inference --apply"))
                    else:
                        add(_probe(f"inference {role}", FAIL if index == 0 else WARN,
                                   f"{member} is granted but did not serve a 1-token request (HTTP {probe_status}); "
                                   "gateway-side, and the chain falls through it",
                                   "report to the gateway owner (token-ops); not a Wax fault"))
                    continue
                visible = member in seen or member.split(":", 1)[0] in seen
                add(_probe(f"inference {role}", PASS if visible else (FAIL if index == 0 else WARN),
                           f"{member} listed by {api_base}/models for this token (User-Agent {USER_AGENT})"
                           if visible else
                           f"{member} is NOT listed for this token; the chain skips it",
                           "" if visible else
                           "python3 deploy/provision-inference --apply   # the SSOT for the token scope "
                           "(skips routes the gateway catalog lacks; re-run after a gateway deploy)"))
            leaked = sorted(m for m in seen if ANTHROPIC_RE.search(m))
            add(_probe("inference token scope", FAIL if leaked else PASS,
                       ("the token still grants Anthropic route(s): " + ", ".join(leaked)) if leaked
                       else f"no Anthropic route among the {len(seen)} listed for this token",
                       "python3 deploy/provision-inference --apply" if leaked else ""))
        add(_chain_serves(api_base, key, chain))

    # -- project-extraction dependencies ------------------------------------
    probe_project_extraction(add, repo=repo, effective=effective, yenv=yenv)

    # -- pass commands and the frontmatter editor --------------------------
    broken, checked = [], 0
    for slug, ep in sorted(passes.registry().items()):
        if not ep.get("enabled"):
            continue
        checked += 1
        argv = ep.get("command") or []
        if not argv:
            broken.append(f"{slug}: no command")
            continue
        cmd = Path(_expand_command(ep) or "").expanduser()
        target = shutil.which(str(cmd)) if not cmd.is_absolute() else str(cmd)
        if not target or not os.access(target, os.X_OK) or not Path(target).is_file():
            broken.append(f"{slug}: {cmd}")
    add(_probe("enabled pass commands", FAIL if broken else PASS,
               "; ".join(broken) if broken else f"all {checked} enabled pass command(s) executable",
               "chmod +x the listed file, or disable the pass in its yaml" if broken else ""))

    try:
        # passes.py reads WAX_FRONTMATTERS from os.environ, so the daemon's value
        # is overlaid for the length of this one call rather than guessed at.
        with _env_overlay({"WAX_FRONTMATTERS": effective.get("WAX_FRONTMATTERS", "")}):
            add(_probe("frontmatters editor", PASS, str(passes._frontmatters_command())))
    except passes.PassError as e:
        add(_probe("frontmatters editor", FAIL, str(e),
                   "set WAX_FRONTMATTERS to a working executable in waxd.service"))

    # -- durability: the one true emergency --------------------------------
    rc, _, err = _run([archive.MC, "ls", f"{archive.ALIAS}/{archive.BUCKET}"], timeout=30)
    add(_probe("minio alias reachable", PASS if rc == 0 else FAIL,
               f"{archive.ALIAS}/{archive.BUCKET}" if rc == 0
               else f"{archive.MC} rc={rc}: {(err or '').strip()[:200]}",
               "" if rc == 0 else f"mc alias set {archive.ALIAS} https://s3.delo.sh <key> <secret>"))

    try:
        usage = shutil.disk_usage(paths.AUDIO)
        floor = paths.MIN_FREE_BYTES
        add(_probe("free space above floor", PASS if usage.free > floor else FAIL,
                   f"{usage.free / 1e9:.1f} GB free at {paths.AUDIO}, floor {floor / 1e9:.1f} GB",
                   "" if usage.free > floor else
                   "archive and remove processed audio, or raise WAX_MIN_FREE_BYTES deliberately"))
    except OSError as e:
        add(_probe("free space above floor", FAIL, f"{paths.AUDIO}: {e}"))

    try:
        unbacked = [
            (row["item_id"], row["path"]) for row in ledger.connect().execute(
                "SELECT i.item_id, i.path FROM items i "
                "LEFT JOIN backups b ON b.item_id=i.item_id AND b.verified_at IS NOT NULL "
                "WHERE b.item_id IS NULL")
            if os.path.exists(row["path"])
        ]
        add(_probe("every live item has a verified S3 backup",
                   PASS if not unbacked else FAIL,
                   "all live items verified in S3" if not unbacked else
                   f"{len(unbacked)} live item(s) with NO verified backup: "
                   + ", ".join(Path(p).name for _, p in unbacked[:5])
                   + (" …" if len(unbacked) > 5 else ""),
                   "" if not unbacked else
                   "wax archive <file>   # the audio is the irreplaceable artifact"))
    except Exception as e:  # noqa: BLE001 - a ledger fault must still be reported
        add(_probe("every live item has a verified S3 backup", FAIL,
                   f"ledger unreadable: {type(e).__name__}: {e}"))

    # -- bus ---------------------------------------------------------------
    reachable = natsclient.reachable()
    add(_probe("nats reachable", PASS if reachable else FAIL,
               f"{natsclient.HOST}:{natsclient.PORT}",
               "" if reachable else "start NATS; events queue in the outbox meanwhile (fail-open)"))
    probe_outbox(add)
    probe_transcriptions(add)

    # -- contract-A stage health -------------------------------------------
    # The two blocks that were unrepresentable during both outages. They are the
    # reason this command exists, so they are reported even when everything the
    # probes above touch is healthy.
    try:
        health = ledger.passes_failed()
        add(_probe("passes.failed (contract A)", PASS if not health["failed"] else FAIL,
                   "no enrichment pass is failing at its current version" if not health["failed"]
                   else f"{health['failed']} item(s) failing: {', '.join(health['slugs'])}",
                   "" if not health["failed"] else "wax ep sweep --dry-run   # then drop --dry-run"))
    except Exception as e:  # noqa: BLE001
        add(_probe("passes.failed (contract A)", FAIL, f"{type(e).__name__}: {e}"))
    try:
        awaiting = pending_pass_event_report()
        if not awaiting:
            add(_probe("pass events enqueued", PASS,
                       "every event declared by a completed pass on a finalized item is in the outbox"))
        else:
            item_id, slug, _ = awaiting[0]
            add(_probe("pass events enqueued", WARN,
                       f"{sum(n for _, _, n in awaiting)} declared event(s) on {len(awaiting)} "
                       f"finalized pass run(s) never reached the outbox, e.g. {slug} on {item_id}",
                       f"wax ep run {slug} {item_id}   # finalize() enqueues them"))
    except Exception as e:  # noqa: BLE001
        add(_probe("pass events enqueued", WARN, f"{type(e).__name__}: {e}"))
    try:
        diar = ledger.diarization_health()
        add(_probe("diarization.degraded (contract A)", FAIL if diar["degraded"] else PASS,
                   f"newest {ledger.DIARIZATION_SAMPLE} transcript(s) all undiarized"
                   if diar["degraded"] else
                   f"{diar['recent_undiarized']} of the newest {ledger.DIARIZATION_SAMPLE} undiarized",
                   "" if not diar["degraded"] else
                   "see the diarization probe above; then re-run `wax transcribe <audio>`"))
    except Exception as e:  # noqa: BLE001
        add(_probe("diarization.degraded (contract A)", FAIL, f"{type(e).__name__}: {e}"))

    # -- registry quarantine --------------------------------------------------
    # A bad pass definition disables ITSELF, never the fleet — but a quarantine
    # still means a pass is not running, so it is loud here.
    try:
        bad = passes.quarantined(passes.registry())
        add(_probe("pass registry quarantine", PASS if not bad else FAIL,
                   "every enabled pass definition is valid" if not bad else
                   "; ".join(f"{slug}: {why}" for slug, why in sorted(bad.items()))[:200],
                   "" if not bad else "fix the YAML in config/passes.d; the quarantine lifts live"))
    except Exception as e:  # noqa: BLE001
        add(_probe("pass registry quarantine", WARN, f"{type(e).__name__}: {e}"))

    # -- pass event schemas ---------------------------------------------------
    # Wax publishes straight to NATS, bypassing bb-emit's guard, so the schema
    # check lives in the runner — and it fails CLOSED on a missing schema. This
    # probe is the pre-flight for that: every enabled pass's emits must resolve
    # to a real schema file before a transcript is the thing that finds out.
    try:
        missing = []
        for slug, ep in sorted(passes.registry().items()):
            if not ep.get("enabled"):
                continue
            for event_type in ep.get("emits") or []:
                try:
                    passes._event_data_schema(event_type)
                except passes.PassError as exc:
                    missing.append(f"{slug}({event_type}): {exc}")
        add(_probe("pass event schemas", PASS if not missing else FAIL,
                   "every enabled pass's emits resolve to a Bloodbank schema" if not missing
                   else "; ".join(missing)[:200],
                   "" if not missing else "author the schema under bloodbank/schemas/bloodbank/audio/ first"))
    except Exception as e:  # noqa: BLE001
        add(_probe("pass event schemas", WARN, f"{type(e).__name__}: {e}"))

    # -- document hygiene -------------------------------------------------------
    # The sweeps move the user's notes, so a silently dead one is worse than a
    # loud one: the worker records every run's summary in ledger.meta, and this
    # reads it back instead of trusting that a job exists.
    try:
        verdict = hygiene.health(pipeline_enabled=state.pipeline_enabled(),
                                 waxd_running=pid is not None,
                                 worker=documents.read_worker_heartbeat())
        add(_probe("document hygiene", verdict["status"], verdict["detail"], verdict["fix"]))
    except Exception as e:  # noqa: BLE001
        add(_probe("document hygiene", FAIL, f"{type(e).__name__}: {e}"))

    return out


def _age_seconds(iso: str) -> float:
    from datetime import datetime, timezone
    try:
        when = datetime.fromisoformat(str(iso).replace("Z", "+00:00"))
    except ValueError:
        return 0.0
    if when.tzinfo is None:
        when = when.replace(tzinfo=timezone.utc)
    return max(0.0, (datetime.now(timezone.utc) - when).total_seconds())


class _env_overlay:
    """Temporarily apply named env values, then restore exactly.

    Only for calling library code that reads os.environ itself. Module-level
    constants (paths.*, passes.REGISTRY_DIR, natsclient.HOST) were resolved at
    import and are NOT affected — which is why the ledger probe compares the
    daemon's open fd against this process's resolution rather than trusting
    either one.
    """

    def __init__(self, values: dict[str, str]):
        self.values = {k: v for k, v in values.items() if v}
        self.saved: dict[str, Optional[str]] = {}

    def __enter__(self):
        for key, value in self.values.items():
            self.saved[key] = os.environ.get(key)
            os.environ[key] = value
        return self

    def __exit__(self, *a):
        for key, previous in self.saved.items():
            if previous is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = previous


def probe_outbox(add) -> None:
    """Outbox liveness, on the same definition of "unpublished" as `wax status`
    (events.unpublished): rows deliberately suppressed are not owed to the bus."""
    try:
        n_unpublished, oldest = events.unpublished()
        stale = _age_seconds(oldest) if oldest else 0.0
        add(_probe("outbox drained", PASS if stale <= OUTBOX_STALE_S else FAIL,
                   f"{n_unpublished} unpublished row(s), oldest {int(stale)}s"
                   if n_unpublished else "outbox empty",
                   "" if stale <= OUTBOX_STALE_S else "wax events drain"))
    except Exception as e:  # noqa: BLE001
        add(_probe("outbox drained", WARN, f"{type(e).__name__}: {e}"))


def probe_transcriptions(add) -> None:
    """The versioned `transcriptions` store (docs/TRANSCRIPTIONS-STORE.md D.8): reachable + schema
    current, projection drained, parity, invariants, embeddings current, the pinned Ollama digest,
    and the ANN plan naming the HNSW index. A store outage never fails a pass, so this is where it shows."""
    try:
        for row in transcriptions.health.probes():
            add(row)
    except Exception as e:  # noqa: BLE001 - one broken probe must not hide the rest of doctor
        add(_probe("transcripts store", FAIL, f"{type(e).__name__}: {e}"))


def doctor(as_json: bool, quiet: bool) -> int:
    pid = waxd_pid()
    denv = proc_env(pid)
    rows = config_rows(denv, unit_env(), yaml_env(), pid is not None)
    probes = probe_all()
    counts = {PASS: 0, WARN: 0, FAIL: 0}
    for probe in probes:
        counts[probe["status"]] += 1
    # 2 on any failure, 1 on warnings only, 0 clean — so both `if wax doctor` and
    # `wax doctor || alert` are usable without parsing anything.
    code = 2 if counts[FAIL] else (1 if counts[WARN] else 0)

    # config.py reads os.environ at call time, so the two ceilings are resolved
    # under the daemon's environment — otherwise `wax doctor` reports the limits
    # of the shell that ran it, which is not a process anyone cares about.
    with _env_overlay({k: denv.get(k, "") for k in
                       ("MAX_AUDIO_FILE_SIZE_FOR_TRANSCRIPTION",
                        "MAX_AUDIO_DURATION_FOR_TRANSCRIPTION")}):
        limits = {"max_audio_bytes": config.max_audio_file_size_for_transcription(),
                  "max_audio_seconds": config.max_audio_duration_for_transcription()}

    if as_json:
        print(json.dumps({
            "ok": code == 0, "exit_code": code, "at": sentinel.utcnow(),
            "waxd_pid": pid, "summary": counts,
            "resolved": {"component_root": str(component.ROOT), "repo_root": str(_repo_root()),
                         "root": str(paths.AUDIO), "ledger": str(paths.DB),
                         "vault": str(paths.VAULT), "passes_dir": str(passes.REGISTRY_DIR),
                         "max_audio_bytes": config.max_audio_file_size_for_transcription(),
                         "max_audio_seconds": config.max_audio_duration_for_transcription()},
            "config": rows, "probes": probes,
        }, indent=2, sort_keys=True, default=str))
        return code
    if quiet:
        return code

    print(f"wax doctor  ·  {sentinel.utcnow()}")
    print(f"  component  {component.ROOT}")
    print(f"  repo       {_repo_root()}")
    print(f"  root       {paths.AUDIO}")
    print(f"  ledger     {paths.DB}")
    print(f"  vault      {paths.VAULT}")
    print(f"  passes.d   {passes.REGISTRY_DIR}")
    print(f"  limits     {limits['max_audio_bytes']} bytes / {limits['max_audio_seconds']:.0f} s per item")
    print()
    print("CONFIGURATION")
    width = max(len(r["name"]) for r in rows)
    vwidth = min(46, max(len(str(r["value"])) for r in rows))
    for r in rows:
        print(f"  {r['name']:<{width}}  {str(r['value']):<{vwidth}}  {r['source']:<22}  {r['consumer']}")
        if r["note"]:
            print(f"  {'':<{width}}  !! {r['note']}")
    print()
    print("PROBES")
    for probe in probes:
        print(f"  {probe['status'].upper():<4}  {probe['probe']:<40}  {probe['detail']}")
        if probe.get("fix"):
            print(f"        {'':<40}  fix: {probe['fix']}")
    print()
    print(f"  {counts[PASS]} pass · {counts[WARN]} warn · {counts[FAIL]} fail  (exit {code})")
    return code


# ---------------------------------------------------------------------------
# ep helpers
# ---------------------------------------------------------------------------

def ep_sweep(*, max_attempts: int, slug: Optional[str], dry_run: bool,
             limit: int) -> dict[str, Any]:
    """Re-drive stranded enrichment passes.

    run_auto() is reached from exactly one place — worker.py, while an item is
    being processed — so an item parked at `complete` could never have a pass
    retried. A transient provider outage was therefore permanent, which is how
    11 title-slug failures sat untouched for five days. The worker now also
    sweeps on a timer (SWEEP_INTERVAL_S); this CLI is the on-demand version and
    the dry-run preview. The work itself lives in worker.sweep_failed_passes.
    """
    targets = ledger.failed_passes_for_sweep(max_attempts)
    unknown_slug = bool(slug) and slug not in passes.registry()
    if slug:
        targets = [t for t in targets if t[1] == slug]
    if limit > 0:
        targets = targets[:limit]
    if dry_run or not targets:
        out: dict[str, Any] = {
            "max_attempts": max_attempts, "slug": slug, "dry_run": dry_run,
            "candidates": len(targets),
            "targets": [{"item_id": i, "ep_slug": s, "attempt": a} for i, s, a in targets],
        }
        if unknown_slug:
            # A typo must not read as "nothing is stranded". That sentence is the
            # failure mode this whole command exists to end.
            out["warning"] = f"{slug!r} is not a registered pass; see `wax ep list`"
        if not dry_run:
            # Nothing to re-drive, but the dead-letter scan still applies.
            out["exhausted"] = passes.sweep_exhaustions(max_attempts)
        return out
    out = worker.sweep_failed_passes(max_attempts=max_attempts, slug=slug, limit=limit)
    out["dry_run"] = False
    if unknown_slug:
        out["warning"] = f"{slug!r} is not a registered pass; see `wax ep list`"
    return out


def _expand_command(ep: dict[str, Any]) -> Optional[str]:
    argv = ep.get("command") or []
    if not argv:
        return None
    return (str(argv[0]).replace("{component_root}", str(component.ROOT))
            .replace("{home}", str(Path.home())))


def ep_list_rows() -> list[dict[str, Any]]:
    """Registered passes with their enabled state, version, and outcome tally.

    Discovery-safe fields only — description, conditions (when/skip_when),
    ordering edges (requires/after), emits and capabilities join the row so a
    human can read the whole routing table here; env (secrets) never appears,
    and outcome detail stays in `wax ep status`.
    """
    registry = passes.registry()
    tally: dict[tuple[str, str, int], int] = {}
    try:
        for row in ledger.connect().execute(
                "SELECT ep_slug, state, version, COUNT(*) AS n FROM passes "
                "GROUP BY ep_slug, state, version"):
            tally[(row["ep_slug"], row["state"], int(row["version"] or 1))] = row["n"]
    except Exception:  # noqa: BLE001 - the registry is still worth listing
        tally = {}
    rows = []
    bad = passes.quarantined(registry)
    for slug, ep in sorted(registry.items()):
        version = int(ep.get("version") or 1)
        counted = {"completed": 0, "failed": 0, "running": 0, "stale": 0}
        for (row_slug, row_state, row_version), n in tally.items():
            if row_slug != slug:
                continue
            if row_version != version:
                # Recorded against a definition that no longer exists. A version
                # bump is how a fixed pass declares itself different from the one
                # that failed, so these must not read as current failures.
                counted["stale"] += n
            else:
                counted[row_state] = counted.get(row_state, 0) + n
        conditions: dict[str, Any] = {}
        if ep.get("when"):
            conditions["when"] = ep["when"]
        if ep.get("skip_when"):
            conditions["skip_when"] = ep["skip_when"]
        rows.append({
            "slug": slug, "enabled": bool(ep.get("enabled")), "auto": bool(ep.get("auto")),
            "version": version, "timeout_s": ep.get("timeout_s"),
            "description": ep.get("description"),
            "capabilities": list(ep.get("capabilities") or []),
            "requires": ep.get("requires") or [],
            "after": ep.get("after") or [],
            "conditions": conditions or None,
            "emits": ep.get("emits") or [],
            # Expanded, not the raw template: the column exists so a human can
            # go look at the file, and `{component_root}` is not a path.
            "command": _expand_command(ep),
            "path": ep.get("_path"), "error": ep.get("error"),
            "quarantined": bad.get(slug),
            **counted,
        })
    return rows


def _reason_of(row: dict[str, Any], width: int = 74) -> str:
    """A failure's reason in one cell, however the ledger happens to store it.

    Three storage shapes are live at once: a `reason_code` column where the
    ledger has migrated, a `reason_code=<code>` first line inside `detail` where
    it has not, and — for every row written before the convention — nothing but
    prose. The prose is still the only thing an operator can act on, so it is
    shown rather than rendered as a blank cell: the 11 rows from the dead-model
    outage all read "HTTP Error 404: Not Found", which is exactly the sentence
    that should have been on a human surface for five days.
    """
    if row.get("reason_code"):
        return str(row["reason_code"])
    head = str(row.get("detail") or "").split("\n", 1)[0].strip()
    if head.startswith("reason_code="):
        return head[len("reason_code="):]
    return head[:width]


def status_unhealthy(snap: dict[str, Any]) -> bool:
    """Whether anything in the snapshot is non-nominal — INCLUDING sub-stages.

    Item state alone was the entire health model, and both week-long outages
    lived below it: every value-producing sub-stage degrades by returning empty
    rather than failing, so an item marched to `complete` with nothing in it.
    The contract-A blocks are therefore first-class terms here, not decoration.
    """
    if (snap.get("passes") or {}).get("failed"):
        return True
    if (snap.get("diarization") or {}).get("degraded"):
        return True
    if snap.get("ledger_error") or snap.get("outbox_error") or snap.get("error"):
        return True
    # The transcriptions store degrades by lagging, never by failing a pass, so `error` here is the
    # only place a long outage or a model digest mismatch becomes visible. Green is not evidence.
    if (snap.get("transcriptions") or {}).get("state") == "error":
        return True
    return any((snap.get(machine) or {}).get("state") in ("error", "error-partial")
               for machine in ("stream", "inbox"))


def render_status(snap: dict[str, Any]) -> None:
    """The human surface. Every line here is a fact something can go wrong in."""
    for machine in ("stream", "inbox"):
        m = snap.get(machine) or {}
        head = m.get("state", "?")
        if m.get("cause_code"):
            head += f" ({m['cause_code']})"
        print(f"  {machine:<12} {head}")
        if m.get("evidence"):
            print(f"  {'':<12}   {m['evidence']}")

    queue = snap.get("queue") or {}
    print(f"  {'queue':<12} {queue.get('total', 0)} in inbox · "
          f"{queue.get('actionable', 0)} actionable · {queue.get('failed', 0)} failed")

    # items_live is the only tally comparable to inbox/queue: `items` counts
    # every row ever minted, including audio that now lives only in S3.
    live = snap.get("items_live") or {}
    items = snap.get("items") or {}
    breakdown = " · ".join(f"{k} {v}" for k, v in sorted(live.items()) if k != "total")
    print(f"  {'items':<12} {live.get('total', 0)} live of {items.get('total', 0)} recorded"
          + (f"  ({breakdown})" if breakdown else ""))

    # The two blocks that no human-facing surface could represent during either
    # outage. They print whether or not they are bad, so "no news" is evidence
    # that they were actually looked at.
    ps = snap.get("passes") or {}
    if ps.get("failed"):
        print(f"  {'passes':<12} FAILING  {ps['failed']} item(s): "
              f"{', '.join(ps.get('slugs') or [])}   -> wax ep sweep --dry-run")
    else:
        print(f"  {'passes':<12} ok       no enrichment pass failing at its current version")

    diar = snap.get("diarization") or {}
    if diar.get("degraded"):
        print(f"  {'diarization':<12} DEGRADED the newest {diar.get('recent_undiarized')} "
              "transcript(s) have no speakers   -> wax doctor")
    else:
        print(f"  {'diarization':<12} ok       "
              f"{diar.get('recent_undiarized', 0)} recent transcript(s) undiarized")

    backlog = snap.get("outbox_backlog")
    if backlog is None:
        print(f"  {'outbox':<12} ERROR {snap.get('outbox_error', 'unknown')}")
    else:
        print(f"  {'outbox':<12} {backlog} unpublished")

    tx = snap.get("transcriptions")
    if tx is not None:
        embed_pending = tx.get("embed_pending")
        line = (f"  {'transcripts':<12} {tx.get('state', '?')} (queued {tx.get('queued', 0)}, "
                f"embed pending {'?' if embed_pending is None else embed_pending})")
        if tx.get("state") not in ("ok", None) and tx.get("reason"):
            line += f"   {tx['reason']}"
        if tx.get("state") in ("error", "lagging"):
            line += "   -> wax doctor"
        print(line)
    for key in ("ledger_error", "tray_queue_error", "error"):
        if snap.get(key):
            print(f"  {key:<12} {snap[key]}")


def _tx_day(value: Any) -> str:
    """YYYY-MM-DD in WAX_TRANSCRIPTS_LOCAL_TZ for an ISO timestamp, or '----------'."""
    if not value:
        return "-" * 10
    try:
        from datetime import datetime
        stamp = datetime.fromisoformat(str(value).replace("Z", "+00:00"))
        if stamp.tzinfo is not None:
            stamp = stamp.astimezone(transcriptions.config.local_tz())
        return stamp.strftime("%Y-%m-%d")
    except (TypeError, ValueError):
        return str(value)[:10]


def _tx_clock(seconds: Any) -> str:
    """mm:ss (minutes may pass 59), or '--:--'."""
    try:
        total = int(round(float(seconds)))
    except (TypeError, ValueError):
        return "--:--"
    return f"{total // 60}:{total % 60:02d}"


def render_transcripts_search(out: dict[str, Any]) -> None:
    results = out.get("results") or []
    print(f"  {len(results)} result(s), mode {out.get('mode')}"
          + (f"  (degraded: {out['degraded']})" if out.get("degraded") else ""))
    for hit in results:
        print(f"  {float(hit.get('score') or 0):.4f}  {_tx_day(hit.get('effective_at'))}  "
              f"{(hit.get('classification') or '-'):<8} {_tx_clock(hit.get('audio_duration_s')):>6}  "
              f"{hit.get('display_title') or '?'}  v{hit.get('version_no')}({hit.get('produced_by')})")
        snippet = " ".join(str(hit.get("snippet") or "").split())
        if snippet:
            print(f"      {snippet[:300]}")
        print(f"      {hit.get('note_path')}")


def render_transcripts_show(out: dict[str, Any]) -> None:
    identity = out.get("transcript") or {}
    version = out.get("version") or {}
    print(f"  #{identity.get('transcript_id')}  {identity.get('wax_item_id') or '-'}  {identity.get('origin')}  "
          f"{_tx_day(identity.get('effective_at'))}  {_tx_clock(identity.get('audio_duration_s'))}")
    print(f"  note     {identity.get('note_path')}"
          + ("   (MISSING since " + str(identity['note_missing_at']) + ")" if identity.get("note_missing_at") else ""))
    if identity.get("audio_s3_uri"):
        print(f"  audio    {identity['audio_s3_uri']}")
    if not version:
        print("  no such version" if out.get("latest_version_no") else "  no version yet (ledger-only identity)")
        return
    print(f"  version  v{version.get('version_no')} of v{out.get('latest_version_no')}  "
          f"{version.get('producer_kind')}/{version.get('produced_by')}  observed {version.get('observed_at')}")
    print(f"  title    {version.get('title') or '-'}")
    if version.get("classification") or version.get("tags"):
        print(f"  class    {version.get('classification') or '-'}   tags {', '.join(version.get('tags') or []) or '-'}")
    if version.get("summary"):
        print(f"  summary  {version['summary']}")
    print()
    print(out.get("content") or "")


def render_transcripts_history(out: dict[str, Any]) -> None:
    identity = out.get("transcript") or {}
    print(f"  #{identity.get('transcript_id')}  {identity.get('wax_item_id') or '-'}  {identity.get('note_relpath')}")
    print("  versions")
    for v in out.get("versions") or []:
        print(f"    v{v.get('version_no'):<3} {str(v.get('observed_at'))[:19]}  "
              f"{v.get('producer_kind')}/{v.get('produced_by')}"
              + (f" v{v['pass_version']}" if v.get("pass_version") is not None else "")
              + ("  BODY CHANGED" if v.get("body_changed") else "")
              + (f"  {', '.join(v.get('changed_fields') or [])}" if v.get("changed_fields") else ""))
    runs = out.get("pass_runs") or []
    print(f"  pass runs ({len(runs)})")
    for r in runs:
        print(f"    {str(r.get('finished_at'))[:19]}  {r.get('slug')} v{r.get('pass_version')} a{r.get('attempt')}  "
              f"{r.get('state')}" + (f" ({r['reason_code']})" if r.get("reason_code") else "")
              + f"  -> {r.get('outcome') or '?'} [{r.get('source')}]")
    moved = [p for p in out.get("paths") or [] if p.get("note_relpath") != identity.get("note_relpath")
             or p.get("role") == "alias"]
    for p in moved:
        print(f"  path     {p.get('role')}: {p.get('note_relpath')}")


def transcripts_command(args, J: bool) -> int:
    """`wax transcripts …` (docs/TRANSCRIPTIONS-STORE.md D.7). StoreUnavailable is a RuntimeError,
    so an unreachable store reaches the handler under __main__: `error: …`, exit 2."""
    if args.sub == "sync":
        out = transcriptions.sync(dry_run=args.dry_run, check=args.check, embed=args.embed, limit=args.limit)
        _emit(out, J)
        return 2 if out.get("drift") or out.get("errors") else 0
    if args.sub == "search":
        try:
            out = transcriptions.search.run(
                " ".join(args.query), limit=args.limit, since=args.since, until=args.until,
                classifications=args.classification, tags=args.tag, projects=args.project, origins=args.origin,
                min_duration=args.min_duration, max_duration=args.max_duration, min_words=args.min_words,
                lexical=args.lexical)
        except ValueError as e:
            print(f"error: {e}", file=sys.stderr)
            return 2
        if J:
            _emit(out, True)
        else:
            render_transcripts_search(out)
        return 0
    if args.sub in ("show", "history"):
        try:
            if args.sub == "show":
                out = transcriptions.show(args.ref, version=args.version, raw=args.raw)
            else:
                out = transcriptions.history(args.ref)
        except LookupError as e:
            print(f"error: {e.args[0] if e.args else e}", file=sys.stderr)
            return 2
        if J:
            _emit(out, True)
        elif args.sub == "show" and args.raw:
            if out.get("raw") is None:
                print(f"error: {args.ref!r} has no version {args.version or '(latest)'}", file=sys.stderr)
                return 2
            sys.stdout.write(out["raw"])
        elif args.sub == "show":
            render_transcripts_show(out)
        else:
            render_transcripts_history(out)
        return 0 if args.sub == "history" or out.get("version") else 2
    if args.sub == "migrate":
        _emit(transcriptions.migrate.apply(dry_run=args.dry_run), J)
        return 0
    if args.sub == "embed":
        _emit(transcriptions.embed.sweep(until_empty=True, limit=args.limit), J)
        return 0
    return 1


def main() -> int:
    # --json accepted at ANY position: `wax --json state stream` and
    # `wax state stream --json` both work. Requiring it before the subcommand
    # is the kind of papercut that makes a tool feel hostile at 3am.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="machine-readable output")

    ap = argparse.ArgumentParser(prog="wax", parents=[common])
    sub = ap.add_subparsers(dest="cmd", required=True)

    rec = sub.add_parser("rec", help="capture lifecycle", parents=[common]).add_subparsers(dest="sub", required=True)
    s = rec.add_parser("start", parents=[common]); s.add_argument("--label"); s.add_argument("--bitrate", default="32k")
    rec.add_parser("stop", parents=[common]).add_argument("rid", nargs="?")
    rec.add_parser("cancel", parents=[common]).add_argument("rid", nargs="?")
    rec.add_parser("salvage", parents=[common]).add_argument("rid", nargs="?")
    rec.add_parser(
        "quiesce",
        help="stop an active capture for session shutdown; idle is success",
        parents=[common],
    )
    rec.add_parser("list", parents=[common])
    t = rec.add_parser("toggle", help="start if ready, stop if recording", parents=[common])
    t.add_argument("--label")

    st = sub.add_parser("state", help="derive a machine's state from disk", parents=[common])
    st.add_argument("machine", choices=["stream", "inbox", "both"], default="both", nargs="?")
    st.add_argument("--cold", action="store_true", help="(default) pure filesystem derivation")

    sub.add_parser("status", parents=[common],
                   help="both machines, queue, and pass/diarization health (exit 2 if unhealthy)")

    h = sub.add_parser("history", help="append-only transition log", parents=[common])
    h.add_argument("-n", type=int, default=20); h.add_argument("--machine", choices=["stream", "inbox", "item"])
    sub.add_parser("items", help="ledger item states", parents=[common])
    sub.add_parser("queue", help="tray queue rows", parents=[common]).add_argument("--clear-completed", action="store_true")
    sk = sub.add_parser("skip", help="preserve a queued item without processing it", parents=[common])
    sk.add_argument("item_id")
    rt = sub.add_parser(
        "retry", help="requeue preserved failed or suspect inbox items", parents=[common]
    )
    rt.add_argument(
        "item_id",
        nargs="?",
        default=None,
        help="item to retry (default: all failed or suspect inbox items)",
    )
    rt.add_argument(
        "--all",
        action="store_true",
        help="retry all failed or suspect items in inbox",
    )

    ep = sub.add_parser("ep", help="enrichment passes", parents=[common]).add_subparsers(dest="sub", required=True)
    selected = ep.add_parser("run-selected", parents=[common])
    selected.add_argument("item_id")
    selected.add_argument("slugs", nargs="+")
    ep.add_parser("list", help="registered passes: enabled, version, outcome tally", parents=[common])
    epr = ep.add_parser("run", help="run ONE pass for ONE transcript", parents=[common])
    epr.add_argument("slug"); epr.add_argument("item_id")
    # Default None so passes.run() resolves MAX(attempt)+1 itself; forcing a
    # number re-mints an already-issued command_id on purpose (replay/debug).
    epr.add_argument("--attempt", type=int, default=None,
                     help="force an attempt number (default: one past the last recorded)")
    eprp = ep.add_parser("replan", parents=[common],
                         help="move ONE unfinished item's plan onto the current authority (dry run "
                              "unless --apply); then `wax ep run` its failed passes")
    eprp.add_argument("item_id")
    eprp.add_argument("--apply", action="store_true", help="write the new plan (nothing runs)")
    epa = ep.add_parser("run-all", help="run every enabled pass for one item", parents=[common])
    epa.add_argument("item_id")
    eps = ep.add_parser("status", help="recorded pass outcomes, newest first", parents=[common])
    eps.add_argument("item_id", nargs="?")
    epw = ep.add_parser("sweep", help="re-drive stranded failed passes", parents=[common])
    epw.add_argument("--max-attempts", type=int, default=3,
                     help="skip passes already tried this many times (default 3)")
    epw.add_argument("--slug", help="limit the sweep to one pass")
    epw.add_argument("--dry-run", action="store_true", help="list targets, run nothing")
    epw.add_argument("--limit", type=int, default=0, help="process at most N targets")

    sub.add_parser("catalog", parents=[common],
                   help="safe discovery: passes and pipelines, no env/bodies/stderr")

    # `wax pipeline` keeps its historical meaning (enable/disable/status of the
    # worker's audio pipeline) and gains the versioned-graph surface: list,
    # compile, show and bindings. Existing invocations are unchanged.
    pl = sub.add_parser("pipeline", parents=[common]).add_subparsers(dest="sub", required=True)
    pl.add_parser("enable", parents=[common], help="start the background drain loop")
    pl.add_parser("disable", parents=[common], help="stop the background drain loop")
    pl.add_parser("status", parents=[common], help="is the background drain loop enabled")
    pll = pl.add_parser("list", parents=[common],
                        help="enrichment pipelines: authored/compiled identity and drift")
    plc = pl.add_parser("compile", parents=[common],
                        help="validate and store authored graphs (explicit; nothing auto-compiles)")
    plc.add_argument("names", nargs="*", help="pipeline names (default: every authored one)")
    pli = pl.add_parser("import", parents=[common],
                        help="compile a supported exported n8n workflow JSON into a pipeline")
    pli.add_argument("file", help="path to the exported workflow JSON")
    pli.add_argument("--name", help="pipeline name slug (default: derived from the workflow name)")
    pls = pl.add_parser("show", parents=[common], help="one pipeline's compiled snapshot")
    pls.add_argument("name")
    plb = pl.add_parser("bindings", parents=[common],
                        help="document folder bindings and processed counts")
    plb.add_argument("name", nargs="?")

    dc = sub.add_parser("documents", help="ordinary Markdown document enrichment",
                        parents=[common]).add_subparsers(dest="sub", required=True)
    dcl = dc.add_parser("list", parents=[common])
    dcl.add_argument("--binding", help="restrict to one binding id")
    dcl.add_argument("--state", help="pending|processing|processed|failed|seeded|trashed|gone")
    dcs = dc.add_parser("scan", parents=[common],
                        help="seed new bindings, then process new arrivals and retryable failures "
                             "(naming a pipeline runs it even while compiled enabled: false)")
    dcs.add_argument("pipeline", nargs="?")
    dcb = dc.add_parser("backfill", parents=[common],
                        help="explicitly process seeded-but-unrun documents")
    dcb.add_argument("pipeline")
    dcb.add_argument("--limit", type=int, default=0)
    dcr = dc.add_parser("run", parents=[common],
                        help="run one compiled pipeline over one document (manual/preview)")
    dcr.add_argument("pipeline"); dcr.add_argument("file")
    dcr.add_argument("--binding", help="binding id that owns the run (receipts and retries)")
    dcx = dc.add_parser("retry", parents=[common],
                        help="re-arm exhausted document receipts (resets their attempt budget)")
    dcx.add_argument("pipeline", nargs="?", help="restrict to one pipeline (default: all)")
    dcx.add_argument("--doc", help="restrict to one document id (doc-<16hex>)")

    dse = dc.add_parser("sweep-empty", parents=[common],
                        help="trash empty notes (vault .trash) and write off vanished documents, "
                             "now; the same job waxd runs on a timer")
    dse.add_argument("--dry-run", action="store_true", help="report only; change nothing")
    dsu = dc.add_parser("sweep-untitled", parents=[common],
                        help="trash empty Untitled*.md, summarize + title + rename the rest, now "
                             "(ignores the nightly hour/date gate and does not set it)")
    dsu.add_argument("--dry-run", action="store_true", help="report only; change nothing")

    trx = sub.add_parser("transcripts", help="versioned transcript store (Postgres `transcriptions`)",
                         parents=[common]).add_subparsers(dest="sub", required=True)
    tsy = trx.add_parser("sync", parents=[common],
                         help="project queued snapshots, then reconcile vault + ledger (backfills unknown notes)")
    tsy.add_argument("--dry-run", action="store_true", help="report what would change; write nothing")
    tsy.add_argument("--check", action="store_true", help="parity report only; exit 2 on drift")
    tsy.add_argument("--embed", action="store_true", help="also run the embed sweep until nothing is pending")
    tsy.add_argument("--limit", type=int, default=0, help="reconcile at most N notes (0 = all)")
    tse = trx.add_parser("search", parents=[common], help="hybrid semantic + keyword search over latest versions")
    tse.add_argument("query", nargs="+")
    tse.add_argument("-n", "--limit", type=int, default=10)
    tse.add_argument("--since", help="ISO date/datetime (effective_at >=)")
    tse.add_argument("--until", help="ISO date/datetime (effective_at <)")
    tse.add_argument("--classification", action="append", choices=["monolog", "meeting", "other"])
    tse.add_argument("--tag", action="append")
    tse.add_argument("--project", action="append")
    tse.add_argument("--origin", action="append", choices=["wax", "hermes-stt", "legacy"])
    tse.add_argument("--min-duration", type=float, help="seconds")
    tse.add_argument("--max-duration", type=float, help="seconds")
    tse.add_argument("--min-words", type=int)
    tse.add_argument("--lexical", action="store_true", help="no query embedding (keyword + title only)")
    tsh = trx.add_parser("show", parents=[common], help="one transcript: identity + latest (or --version N)")
    tsh.add_argument("ref", help="wax item id, #transcript_id, or note filename/path (fuzzy)")
    tsh.add_argument("--version", type=int, help="version_no (default: latest)")
    tsh.add_argument("--raw", action="store_true", help="print that version's exact note bytes")
    thi = trx.add_parser("history", parents=[common], help="every version and pass run of one transcript")
    thi.add_argument("ref", help="wax item id, #transcript_id, or note filename/path (fuzzy)")
    tmi = trx.add_parser("migrate", parents=[common], help="apply pending schema migrations (owner role)")
    tmi.add_argument("--dry-run", action="store_true")
    tem = trx.add_parser("embed", parents=[common], help="embed pending chunk/doc vectors now")
    tem.add_argument("--limit", type=int, default=0, help="embed at most N inputs (0 = until nothing is pending)")

    rc = sub.add_parser("reconcile", help="rebuild the ledger from durable sources", parents=[common])
    rc.add_argument("--rebuild", action="store_true")

    ev = sub.add_parser("events", help="bloodbank outbox", parents=[common])
    ev.add_argument("action", choices=["backlog", "drain"], nargs="?", default="backlog")

    mg = sub.add_parser("migrate", help="fold legacy dirs into the one inbox", parents=[common])
    mg.add_argument("--plan", action="store_true", help="READ-ONLY: classify and write a manifest")
    mg.add_argument("--dry-run", action="store_true", help="show exactly what apply would do")
    mg.add_argument("--apply", action="store_true", help="EXECUTE the plan (moves/copies; deletes nothing)")

    ar = sub.add_parser("archive", help="upload to S3 and size-verify", parents=[common])
    ar.add_argument("file"); ar.add_argument("--audit", action="store_true")

    tr = sub.add_parser("transcribe", help="transcribe with the sanity gate", parents=[common])
    tr.add_argument("file")

    dr = sub.add_parser("drain", help="process inbox items now (one-shot)", parents=[common])
    dr.add_argument("-n", type=int, default=1, help="max items to process")

    doc = sub.add_parser(
        "doctor", parents=[common],
        help="resolved config + probe every dependency (exit 2 fail, 1 warn, 0 clean)")
    doc.add_argument("--quiet", action="store_true", help="print nothing; exit code only")

    args = ap.parse_args()
    J = args.json

    if args.cmd == "rec":
        if args.sub == "toggle":
            # Single entry point for the hotkey. The lock is held across the
            # decision AND the action so a double-tap cannot start two captures
            # or race a stop.
            with _Lock():
                cur = state.stream_state()
                if cur["state"] == "recording":
                    out = capture.stop(cur["rid"])
                    out["action"] = "stopped"
                elif cur["state"] == "ready":
                    r = capture.start(trigger="hotkey", label=args.label)
                    out = {"action": "started", "rid": r.get("rid"),
                           "target": r.get("target_name")}
                else:
                    # Never silently do nothing: an unexpected state is exactly
                    # when the user most needs to be told.
                    out = {"action": "refused", "state": cur["state"],
                           "cause_code": cur.get("cause_code"),
                           "evidence": cur.get("evidence")}
            _emit(out, J)
            return 0 if out["action"] != "refused" else 2
        if args.sub == "start":
            with _Lock():
                rec_json = capture.start(trigger="cli", label=args.label, bitrate=args.bitrate)
            _emit({"started": rec_json.get("rid"), "target": rec_json.get("target_name"),
                   "source": rec_json.get("device_source"), "pid": rec_json.get("pid")}, J)
            return 0
        if args.sub == "list":
            _emit([{"rid": r, "segments": len(sentinel.segments(r)),
                    "bytes": sentinel.segment_bytes(r)} for r in sentinel.list_captures()], J)
            return 0
        if args.sub == "quiesce":
            with _Lock():
                _emit(capture.quiesce(), J)
            return 0
        rid = args.rid or _active_rid()
        with _Lock():
            if args.sub == "stop":
                _emit(capture.stop(rid), J)
            elif args.sub == "cancel":
                _emit(capture.cancel(rid), J)
            elif args.sub == "salvage":
                _emit(capture.salvage(rid), J)
        return 0

    if args.cmd == "state":
        if args.machine == "stream":
            out = state.stream_state()
        elif args.machine == "inbox":
            out = state.inbox_state()
        else:
            out = state.snapshot()
        _emit(out, J)
        # Exit code carries severity so scripts can gate on it. `wax state`
        # with no machine returns the two-machine snapshot, which has no
        # top-level "state" key — so it exited 0 even with inbox in error,
        # while `wax state inbox` on the same instant exited 2.
        severities = ([out["state"]] if "state" in out else
                      [(out.get(m) or {}).get("state") for m in ("stream", "inbox")])
        if any(sev in ("error", "error-partial") for sev in severities):
            return 2
        return 0

    if args.cmd == "status":
        snap = ledger.enrich(state.snapshot())
        if J:
            _emit(snap, True)
        else:
            render_status(snap)
        # Documented contract (WAX-DESIGN.md): 0 all green, 2 anything
        # non-nominal. It returned 0 unconditionally, which is how a week of
        # 100% pass failure and empty diarization scripted as healthy.
        return 2 if status_unhealthy(snap) else 0

    if args.cmd == "history":
        rows = ledger.history(limit=args.n, machine=args.machine)
        if J:
            _emit(rows, True)
        else:
            for r in reversed(rows):
                arrow = f"{r['from_state'] or '-'} -> {r['to_state']}"
                print(f"  [{r['seq']:>4}] {r['at'][11:19]} {r['machine']:<7} {arrow:<34} "
                      f"{r['cause_code'] or ''} {(r['subject'] or '')[:18]}")
        return 0

    if args.cmd == "items":
        _emit(ledger.counts(), J)
        return 0

    if args.cmd == "queue":
        if args.clear_completed:
            ledger.clear_tray_completed()
        active = (state.inbox_state() or {}).get("active_item")
        rows = ledger.tray_items(active)
        active_row = next((row for row in rows if row.get("active")), None)
        if active_row:
            active_row.update(transcribe_adapter.progress_for(active_row["item_id"]))
        _emit(rows, J)
        return 0

    if args.cmd == "skip":
        _emit(worker.skip_item(args.item_id), J)
        return 0

    if args.cmd == "retry":
        if args.item_id and not args.all:
            res = worker.retry_item(args.item_id)
            if J:
                _emit(res, J)
            else:
                cause = f" (was {res['previous_cause']})" if res.get("previous_cause") else ""
                print(f"requeued {res['item_id']}{cause}: {res['path']}")
            return 0
        items = worker.retry_failed_items()
        if J:
            print(json.dumps(items, indent=2, sort_keys=True, default=str))
        else:
            if not items:
                print("no failed or suspect items in inbox")
            for r in items:
                cause = f" (was {r['previous_cause']})" if r.get("previous_cause") else ""
                print(f"requeued {r['item_id']}{cause}: {r['path']}")
        return 0

    if args.cmd == "archive":
        f = Path(args.file)
        if args.audit:
            _emit(archive.audit([f]), J)
            return 0
        _emit(archive.archive(f), J)
        return 0

    if args.cmd == "transcribe":
        _emit(transcribe_adapter.transcribe(Path(args.file)), J)
        return 0

    if args.cmd == "ep":
        if args.sub == "run-selected":
            _emit(worker.retry_failed_passes(args.item_id, tuple(args.slugs)), J)
            return 0
        if args.sub == "list":
            rows = ep_list_rows()
            if J:
                _emit(rows, True)
            else:
                print(f"  {'SLUG':<24} {'EN':<4}{'AUTO':<6}{'VER':<5}{'T/O':<7}"
                      f"{'OK':<5}{'FAIL':<6}{'STALE':<7}COMMAND")
                for r in rows:
                    print(f"  {r['slug']:<24} {'yes' if r['enabled'] else 'no':<4}"
                          f"{'yes' if r['auto'] else 'no':<6}{r['version']:<5}"
                          f"{str(r['timeout_s']) + 's':<7}{r['completed']:<5}{r['failed']:<6}"
                          f"{r['stale']:<7}{r['command'] or '-'}")
                    if r.get("description"):
                        print(f"  {'':<24} {str(r['description']).strip().splitlines()[0][:96]}")
                    extras = []
                    if r.get("capabilities"):
                        extras.append(f"capabilities: {', '.join(r['capabilities'])}")
                    if r.get("after"):
                        extras.append(f"after: {', '.join(r['after'])}")
                    if r.get("emits"):
                        extras.append(f"emits: {', '.join(r['emits'])}")
                    if extras:
                        print(f"  {'':<24} {' · '.join(extras)}")
                    if r.get("conditions"):
                        print(f"  {'':<24} conditions: {json.dumps(r['conditions'])}")
                    if r["error"]:
                        print(f"  {'':<24} !! {r['error']}")
                    if r.get("quarantined"):
                        print(f"  {'':<24} !! QUARANTINED: {r['quarantined']}")
                # STALE is not a failure: it is history recorded against a pass
                # definition that has since been versioned past.
                print("\n  OK/FAIL count rows at the CURRENTLY registered version; "
                      "STALE were recorded against an older one.")
            return 0
        if args.sub == "run":
            result = passes.run(args.item_id, args.slug, attempt=args.attempt)
            result["pass_events"] = finalize.publish_pass_events(args.item_id)
            result["completion"] = finalize.finalize(args.item_id)
            _emit(result, J)
            return 0
        if args.sub == "replan":
            try:
                _emit(passes.replan(args.item_id, apply=args.apply), True)
            except passes.PassError as e:
                print(f"refused: {e}", file=sys.stderr)
                return 2
            return 0
        if args.sub == "run-all":
            _emit({"results": passes.run_all(args.item_id),
                   "pass_events": finalize.publish_pass_events(args.item_id),
                   "completion": finalize.finalize(args.item_id)}, J)
            return 0
        if args.sub == "status":
            rows = passes.status(args.item_id)
            if J:
                _emit(rows, True)
            else:
                print(f"  {'ITEM':<38}{'SLUG':<22}{'STATE':<11}{'V':<3}{'ATT':<5}"
                      f"{'UPDATED':<21}REASON")
                for r in rows:
                    print(f"  {r['item_id']:<38}{r['ep_slug']:<22}{r['state']:<11}"
                          f"{r.get('version') or 1:<3}{r.get('attempt') or 1:<5}"
                          f"{str(r.get('updated_at') or '')[:19]:<21}{_reason_of(r)}")
            return 0
        if args.sub == "sweep":
            out = ep_sweep(max_attempts=args.max_attempts, slug=args.slug,
                           dry_run=args.dry_run, limit=args.limit)
            if J:
                _emit(out, True)
            else:
                verb = "WOULD RE-RUN" if out["dry_run"] else "RE-RAN"
                print(f"  {verb} {out['candidates']} stranded pass(es) "
                      f"(max_attempts={out['max_attempts']}"
                      f"{', slug=' + out['slug'] if out['slug'] else ''})")
                for t in out["targets"]:
                    print(f"    {t['ep_slug']:<22} {t['item_id']}  attempt {t['attempt']}")
                for r in out.get("results", []):
                    mark = "ok  " if r.get("state") == "completed" else "FAIL"
                    print(f"    {mark} {r['ep_slug']:<22} {r['item_id']}  "
                          f"{r.get('reason_code') or ''} {(r.get('error') or '').splitlines()[0][:70] if r.get('error') else ''}")
                if out.get("warning"):
                    print(f"    !! {out['warning']}")
                elif not out["candidates"]:
                    print("    nothing stranded — every failed pass is either "
                          "disabled or past --max-attempts")
            # A sweep that re-ran something and it failed again is not success;
            # neither is one aimed at a pass that does not exist.
            return 2 if (out.get("failed") or out.get("warning")) else 0
        return 1

    if args.cmd == "catalog":
        # The one safe discovery read: purposes, capabilities, availability,
        # conditions, edges, bindings and bounded outcome counts. No env, no
        # command bodies, no stderr — Holocene and n8n consume exactly this.
        _emit(catalog.snapshot(), J)
        return 0

    if args.cmd == "pipeline":
        if args.sub in ("enable", "disable", "status"):
            # The historical worker toggle, unchanged.
            if args.sub == "enable":
                state.ENABLED_FLAG.parent.mkdir(parents=True, exist_ok=True)
                state.ENABLED_FLAG.touch()
            elif args.sub == "disable":
                state.ENABLED_FLAG.unlink(missing_ok=True)
            _emit({"enabled": state.pipeline_enabled()}, J)
            return 0
        if args.sub == "list":
            rows = catalog.pipeline_catalog()["pipelines"]
            if J:
                _emit(rows, True)
            else:
                for r in rows:
                    head = (f"{r['name']:<22} v{r.get('version', '-')}"
                            f"  {r.get('trigger', '?'):<14}"
                            f"{'enabled' if r.get('enabled') else 'disabled':<9}"
                            f"{r['drift']['state']}")
                    print(f"  {head}")
                    if r.get("description"):
                        print(f"  {'':<22} {str(r['description']).strip().splitlines()[0][:96]}")
                    if r["drift"].get("detail"):
                        print(f"  {'':<22} !! {r['drift']['detail']}")
                    if r.get("authored_error"):
                        print(f"  {'':<22} !! {r['authored_error']}")
            return 0
        if args.sub == "compile":
            out = pipelines.compile(args.names or None)
            if J:
                _emit(out, True)
            else:
                for c in out.get("compiled", []):
                    print(f"  compiled {c['name']} v{c['version']} ({c['definition_id'][:12]})")
                for c in out.get("unchanged", []):
                    print(f"  unchanged {c['name']} ({c['definition_id'][:12]})")
                for name, why in out.get("failed", {}).items():
                    print(f"  !! {name}: {why}", file=sys.stderr)
            return 2 if out.get("failed") else 0
        if args.sub == "import":
            try:
                out = pipelines.import_n8n(Path(args.file), name=args.name)
            except pipelines.PipelineError as e:
                print(f"error: {e}", file=sys.stderr)
                return 2
            if J:
                _emit(out, True)
            else:
                print(f"  imported {out['imported']} v{out['version']} from n8n workflow "
                      f"{out['workflow']!r} ({out['nodes']} nodes, {out['edges']} edges, "
                      f"{out['definition_id'][:12]})")
            return 0
        if args.sub == "show":
            snapshot = catalog.pipeline_catalog()
            row = next((p for p in snapshot["pipelines"] if p["name"] == args.name), None)
            if row is None:
                print(f"error: no pipeline named {args.name!r}", file=sys.stderr)
                return 2
            _emit(row, J)
            return 0
        if args.sub == "bindings":
            _emit(documents.status(pipeline=args.name), J)
            return 0
        return 1

    if args.cmd == "documents":
        if args.sub == "list":
            _emit(documents.list_documents(
                binding_id=args.binding or None, state=args.state), J)
            return 0
        if args.sub == "scan":
            out = documents.scan(pipeline=args.pipeline)
            _emit(out, J)
            failed = sum(1 for b in out.get("bindings", [])
                         for r in (b.get("results") or []) if r.get("failed"))
            return 2 if failed else 0
        if args.sub == "backfill":
            out = documents.backfill(pipeline=args.pipeline, limit=args.limit)
            _emit(out, J)
            return 2 if out.get("failed") else 0
        if args.sub == "run":
            binding = ""
            if args.binding:
                binding = args.binding
            out = pipelines.run_document(args.pipeline, Path(args.file),
                                         binding_id=binding, explicit=True)
            _emit(out, J)
            return 2 if out.get("failed") else 0
        if args.sub == "retry":
            out = documents.retry_exhausted(pipeline=args.pipeline, doc_id=args.doc)
            _emit(out, J)
            return 0
        if args.sub in ("sweep-empty", "sweep-untitled"):
            sweep = (hygiene.sweep_empty if args.sub == "sweep-empty"
                     else hygiene.sweep_untitled)
            out = sweep(dry_run=args.dry_run)
            _emit(out, J)
            return 2 if out.get("last_error") else 0
        return 1

    if args.cmd == "reconcile":
        if not args.rebuild:
            print("pass --rebuild to reconstruct the ledger", file=sys.stderr)
            return 2
        _emit(reconcile.rebuild(), J)
        return 0

    if args.cmd == "events":
        _emit(events.drain() if args.action == "drain" else {"backlog": events.backlog()}, J)
        return 0

    if args.cmd == "drain":
        done = []
        for _ in range(args.n):
            r = worker.run_once()
            if r is None:
                break
            done.append(r)
        _emit(done or {"drained": 0, "note": "nothing pending"}, J)
        return 0

    if args.cmd == "migrate":
        if args.apply or args.dry_run:
            r = migrate.apply(dry_run=not args.apply)
            if J:
                _emit(r, True)
            else:
                print(f"  {'DRY RUN' if r['dry_run'] else 'APPLIED'}: total={r['total']} "
                      f"moved={r['moved']} copied={r['copied']} skipped={r['skipped']} failed={r['failed']}")
                for x in r["results"]:
                    if x["result"] in ("failed", "vanished"):
                        print(f"    !! {x['result']}: {x['name']} {x.get('error','')}")
                if r.get("manifest"):
                    print(f"  manifest: {r['manifest']}")
            return 2 if r["failed"] else 0
        if not args.plan:
            print("refusing to act without --plan/--dry-run/--apply", file=sys.stderr)
            return 2
        m = migrate.plan()
        path = migrate.write_manifest(m)
        if J:
            _emit(m, True)
            return 0
        t = m["totals"]
        print(f"  candidates          {t['candidates']}  ({t['bytes']/1e9:.2f} GB)")
        print(f"  unique content      {t['unique_content']}")
        print(f"  exact duplicates    {t['exact_duplicates']}  (skipped, not deleted)")
        print(f"  name collisions     {t['name_collisions']}  <- a bare mv would destroy one side")
        print(f"  already in S3       {t['with_s3_backup']}")
        print(f"  NOT in S3           {t['without_s3_backup']}")
        print(f"  already transcribed {t['with_transcript']}")
        print(f"  NOT transcribed     {t['without_transcript']}")
        if m["name_collisions"]:
            print("\n  collisions:")
            for n, shas in m["name_collisions"].items():
                print(f"    {n}: {len(shas)} distinct contents")
        print(f"\n  manifest: {path}")
        print("  nothing was moved.")
        return 0

    if args.cmd == "transcripts":
        return transcripts_command(args, J)

    if args.cmd == "doctor":
        return doctor(J, args.quiet)

    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (capture.CaptureError, archive.ArchiveError, passes.PassError,
            pipelines.PipelineError,
            transcribe_adapter.TranscribeError, RuntimeError, SystemExit) as e:
        if isinstance(e, SystemExit):
            raise
        print(f"error: {e}", file=sys.stderr)
        sys.exit(2)
