ANTHROPIC_RE = re.compile(r"claude|sonnet|haiku|opus|fable|anthropic", re.IGNORECASE)
TITLE_KEY_OP_DEFAULT = "op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/heyma-wax-inference"
# api.automaticai.io sits behind Cloudflare, which answers urllib's default
# User-Agent with "403 error code: 1010" before the gateway sees the request.
# The passes send this one; the doctor must look like them.
USER_AGENT = "HeyMa-Wax/1.0"
# HeyMa's frozen canonical pjangler id (.project.json `project_id`); the repo
# was called transcription-queue before it was HeyMa and the id never changed.
HEYMA_PROJECT_ID = "transcription-queue"
# NeMo's import is substantial even though the owned adapter deliberately does
# not restore weights at import time. Keep it bounded so doctor cannot hang.
DIARIZATION_IMPORT_TIMEOUT_S = 120


def _repo_root() -> Path:
    """The checkout that owns this component — the unit of "the DEPLOYED repo".

    Resolved by walking up to the .git, never assumed: a second checkout on the
    same machine is precisely the bug the transcriber probe exists to catch, and
    a hardcoded path could not tell the two apart.
    """
    for parent in (COMPONENT_ROOT, *COMPONENT_ROOT.parents):
        if (parent / ".git").exists():
            return parent
    return COMPONENT_ROOT


def _run(argv: list[str], timeout: float = CMD_TIMEOUT_S) -> tuple[int, str, str]:
    """Subprocess with a mandatory timeout; a hung probe is a broken probe."""
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 124, "", f"timed out after {timeout}s"
    except OSError as e:
        return 127, "", str(e)
    return r.returncode, r.stdout, r.stderr


def waxd_pid() -> Optional[int]:
    """PID of the live daemon, or None. Verified against /proc, never guessed."""
    candidates: list[int] = []
    rc, out, _ = _run(["systemctl", "--user", "show", "waxd.service",
                       "-p", "MainPID", "--value"], timeout=10)
    if rc == 0 and out.strip().isdigit():
        candidates.append(int(out.strip()))
    try:
        # The singleton lock names the pid even when the unit is not the thing
        # running waxd (a hand-started daemon during development).
        candidates.append(int(Path(paths.VAR / "waxd.singleton.lock").read_text().split()[0]))
    except (OSError, ValueError, IndexError):
        pass
    for pid in candidates:
        if pid <= 0:
            continue
        try:
            cmdline = Path(f"/proc/{pid}/cmdline").read_bytes().decode("utf-8", "replace")
        except OSError:
            continue
        if "waxd" in cmdline:
            return pid
    return None


def proc_env(pid: Optional[int]) -> dict[str, str]:
    """The daemon's OWN environment, read from /proc.

    This is the only honest source for "what is Wax configured with": this CLI
    runs in an interactive shell whose exports the user unit never sees, so
    reporting os.environ would describe a process nobody is running.
    """
    if pid is None:
        return {}
    try:
        raw = Path(f"/proc/{pid}/environ").read_bytes().decode("utf-8", "replace")
    except OSError:
        return {}
    out = {}
    for entry in raw.split("\0"):
        key, sep, value = entry.partition("=")
        if sep:
            out[key] = value
    return out


def unit_env() -> dict[str, str]:
    """Environment= of the INSTALLED unit, asked of systemd rather than parsed.

    deploy/systemd/user/waxd.service carries @PLACEHOLDER@ tokens and can drift
    from what is actually loaded; reading the template would report a config no
    process has.
    """
    rc, out, _ = _run(["systemctl", "--user", "show", "waxd.service",
                       "-p", "Environment", "--value"], timeout=10)
    if rc != 0:
        return {}
    env = {}
    try:
        tokens = shlex.split(out.strip())
    except ValueError:
        tokens = out.split()
    for token in tokens:
        key, sep, value = token.partition("=")
        if sep:
            env[key] = value
    return env


def yaml_env() -> dict[str, tuple[str, str]]:
    """{VAR: (slug, value)} declared by pass definitions.

    passes.run() copies os.environ and then OVERWRITES it with the yaml block,
    so for any variable a pass declares the yaml value is the effective one —
    whatever the unit or the shell says.
    """
    out: dict[str, tuple[str, str]] = {}
    for slug, ep in sorted(passes.registry().items()):
        for key, value in (ep.get("env") or {}).items():
            out.setdefault(str(key), (slug, str(value)))
    return out


def _redact(name: str, value: Optional[str], *, is_default: bool = False) -> Optional[str]:
    if value is None or not SECRET_NAME_RE.search(name):
        return value
    # A spec placeholder (<unset>, <PATH lookup: …>) is documentation, not a
    # value; redacting it printed "<redacted: 7 chars>" for a variable nobody
    # had set, which reads as a configured secret.
    if is_default or value.startswith("op://") or not value:
        return value
    return f"<redacted: {len(value)} chars>"


