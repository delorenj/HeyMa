#!/usr/bin/python3
# NOTE: /usr/bin/python3 explicitly, never `env python3` — mise's Python is
# first on PATH and lacks gi/evdev, which would break the tray and hotkey.
"""wax — control and inspect the Wax recorder.

Works with or without the daemon. `state --cold` is a pure function of the
filesystem, so it answers correctly even after waxd has been SIGKILLed.
"""

import os
import signal


def _interrupted_while_starting(_signum, _frame):
    """Ctrl-C before main() runs: nothing has happened yet, so leave quietly (no traceback)."""
    try:
        os.write(2, b"interrupted\n")
    except OSError:
        pass
    os._exit(130)


# Only when run as the command: importing this file (tests, SourceFileLoader) leaves the
# host's signal handling alone. Installed before every other import (hence the file-level
# `ruff: noqa: E402` below), and kept until main() is inside its try.
if __name__ == "__main__":
    # Only when Ctrl-C would otherwise raise: a launcher that ignores SIGINT keeps it ignored.
    if signal.getsignal(signal.SIGINT) is signal.default_int_handler:
        signal.signal(signal.SIGINT, _interrupted_while_starting)
    # The repo-root launcher holds Ctrl-C blocked across Python's own start-up and says so
    # here; a press that came in meanwhile is delivered now, to the handler above. A mask the
    # launcher found already in place belongs to whoever started wax and stays.
    if os.environ.pop("WAX_SIGINT_HELD", None) == "1":
        signal.pthread_sigmask(signal.SIG_UNBLOCK, {signal.SIGINT})

