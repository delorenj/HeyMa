#!/usr/bin/python3
# NOTE: /usr/bin/python3 explicitly, never `env python3` — mise's Python is
# first on PATH and lacks gi/evdev, which would break the tray and hotkey.
"""wax — control and inspect the Wax recorder.

Works with or without the daemon. `state --cold` is a pure function of the
filesystem, so it answers correctly even after waxd has been SIGKILLed.
"""

import argparse
import fcntl
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any, Optional

COMPONENT_ROOT = next(
    parent for parent in Path(__file__).resolve().parents
    if (parent / "pyproject.toml").is_file()
)
sys.path.insert(0, str(COMPONENT_ROOT / "src"))

from wax import (archive, catalog, capture, component, config, documents, events, finalize,
                 hygiene, ledger, migrate, natsclient, passes, paths, pipelines, provider, reconcile, sanity,
                 sentinel, state, transcribe_adapter, transcriptions, worker)  # noqa: E402


def _emit(obj, as_json: bool) -> None:
    if as_json:
        print(json.dumps(obj, indent=2, sort_keys=True, default=str))
    else:
        if isinstance(obj, dict) and "state" in obj:
            line = obj["state"]
            if obj.get("cause_code"):
                line += f"  ({obj['cause_code']})"
            print(line)
            if obj.get("evidence"):
                print(f"  evidence: {obj['evidence']}")
            for k in ("rid", "pending", "active_item", "partial_bytes"):
                if obj.get(k) is not None:
                    print(f"  {k}: {obj[k]}")
        else:
            print(json.dumps(obj, indent=2, sort_keys=True, default=str))


class _Lock:
    """Serialise capture lifecycle ops so two starts cannot race the state check."""

    def __enter__(self):
        paths.ensure_dirs()
        self.fh = open(paths.LOCK, "w")
        fcntl.flock(self.fh, fcntl.LOCK_EX)
        return self

    def __exit__(self, *a):
        fcntl.flock(self.fh, fcntl.LOCK_UN)
        self.fh.close()


def _active_rid() -> str:
    rids = sentinel.list_captures()
    if not rids:
        raise SystemExit("no active capture")
    return rids[0]


# ---------------------------------------------------------------------------
# doctor — resolved configuration plus one probe per thing that can rot
# ---------------------------------------------------------------------------
# Wax does not fail by crashing, it fails by degrading. A deleted Ollama model
# and a deleted vendored diarization package each ran at 100% failure for days
# behind a green tray, a `wax status` that printed "no errors", and a journal
# with zero waxd lines. Every probe below exists because the thing it checks was
# once silently wrong. The rule for this command is therefore narrow and
# absolute: it may deliver bad news, but it may never report health it has not
# just verified, and it may never print a resolved secret.

PASS, WARN, FAIL = "pass", "warn", "fail"

# Names whose VALUE is a credential. `op://…` references are exempt: publishing
# the reference is the whole point of storing one, and redacting it would hide
# the single most useful field when a key stops resolving.
SECRET_NAME_RE = re.compile(r"(KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL)", re.IGNORECASE)

MIRROR_MAX_AGE_S = 180      # waxd rewrites state.json at 1 Hz; 180 s is 180 misses
OUTBOX_STALE_S = 600
CMD_TIMEOUT_S = 20          # every subprocess doctor spawns; it must never hang
HTTP_TIMEOUT_S = 15
PJ_TIMEOUT_S = 5
# pjangler's registry binds loopback only and has no auth; `localhost` can
# resolve to ::1 first, where it is not listening.
PJ_REGISTRY_DEFAULT = "http://127.0.0.1:8764"
# Jev goes through the fleet's Jev ingress (jev-litellm, LiteLLM's TypeSafe
# pass-through): the AutomaticAI gateway has no decisions route. HeyMa holds
# its own LiteLLM virtual key there. These mirror wax.jev and
# passes.d/bin/project-extraction.
JEV_URL_DEFAULT = "https://jev.delo.sh/typesafe/v1/systemone"
JEV_MODEL_DEFAULT = "jev-1.13.0"
JEV_KEY_OP_DEFAULT = "op://DeLoSecrets/4y3hlfp2dowbzpi6ncp67kdm5i/credential"
# Chat passes (title-slug, classification, ticketable) go through the
# AutomaticAI gateway's auto/fast role on the scoped heyma-wax-inference token;
# these mirror the bin defaults in config/passes.d/bin/{title-slug,ticketable}.
TITLE_API_BASE_DEFAULT = "https://api.automaticai.io/v1"
TITLE_MODEL_DEFAULT = "automaticai/auto/fast"
# Ordered fallbacks after the primary: explicit subscription GLM, then metered
# DeepSeek (Hyper is gateway-blocked, AAI-64), then the free family. Operator
# order 2026-10-22: no Anthropic model anywhere (chat_pass_routing_test).
