#!/usr/bin/python3
# NOTE: /usr/bin/python3 explicitly, never `env python3` — mise's Python is
# first on PATH and has no gi, which would break the tray silently.
"""waxd — owns the tray, mirrors state, and serves status.

Deliberately NOT the owner of the capture lifecycle: `wax rec …` works whether
or not this daemon is running, and a capture started by the CLI survives
`systemctl --user restart waxd` because the encoder lives in its own transient
scope. The daemon is a *view* plus a convenience toggle, so its death can never
cost you a recording.
"""

import fcntl
import json
import logging
import os
import socket
import socketserver
import subprocess
import sys
import threading
import time
from pathlib import Path
from typing import Optional

COMPONENT_ROOT = next(
    parent for parent in Path(__file__).resolve().parents
    if (parent / "pyproject.toml").is_file()
)
sys.path.insert(0, str(COMPONENT_ROOT / "src"))

import gi  # noqa: E402

gi.require_version("Gtk", "3.0")
from gi.repository import GLib  # noqa: E402

from wax import capture, events as events_mod, ledger, paths, state, tray as tray_mod, transcribe_adapter, worker as worker_mod  # noqa: E402

POLL_MS = 1000
SINGLETON = paths.VAR / "waxd.singleton.lock"

# Contract B names loggers "wax.<module>", but __name__ is "__main__" in a
# script, so the name comes from the filename instead — "wax.waxd", which is
# what the journal shows and what an operator would grep for.
log = logging.getLogger("wax." + Path(__file__).name)

# systemd stamps its own timestamp and unit name onto every captured stderr
# line, so repeating either here just makes the journal harder to read. Level
# and logger name are the two things it cannot know.
LOG_FORMAT = "%(levelname)s %(name)s: %(message)s"

# A condition inside _tick recurs at 1 Hz. Logging it unconditionally writes
# ~86k identical lines a day, which is exactly as unreadable as the silence it
# replaced, so a repeating condition is logged on CHANGE and then re-asserted
# only this often — long enough to stay quiet, short enough that a fault cannot
# scroll out of a journal window unmentioned.
LOG_REPEAT_S = 300.0


def _configure_logging() -> None:
    """The ONE handler configuration for the whole component (contract B).

    Library modules only ever call getLogger("wax.<module>"); none of them
    configures a handler. With nobody installing one, Python's lastResort
    handler prints WARNING and above unformatted and DROPS every INFO line —
    which is why a week of 100% pass failure and empty diarization produced
    zero waxd lines in the journal. Installing it here, before anything else
    runs, is what makes the daemon capable of saying it is unwell.
    """
    requested = os.environ.get("WAX_LOG_LEVEL", "INFO").strip().upper() or "INFO"
    # getLevelName() is the only mapping that answers for aliases (FATAL, WARN)
    # without getattr() happily returning logging.StreamHandler for a typo.
    level = logging.getLevelName(requested)
    bad = None
    if not isinstance(level, int):
        bad, level = requested, logging.INFO
    handler = logging.StreamHandler(sys.stderr)
    handler.setFormatter(logging.Formatter(LOG_FORMAT))
    handler.setLevel(level)
    root = logging.getLogger()
    # Replace rather than append: a second handler would double every line if
    # this were ever reached twice.
    root.handlers[:] = [handler]
    root.setLevel(level)
    if bad:
        log.warning("WAX_LOG_LEVEL=%r is not a level name; using INFO", bad)


def _singleton():
    paths.ensure_dirs()
    fh = open(SINGLETON, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log.error("waxd already running (singleton lock held): %s", SINGLETON)
        raise SystemExit(1)
    fh.write(f"{os.getpid()}\n")
    fh.flush()
    return fh  # keep referenced for process lifetime


class Daemon:
    def __init__(self):
        self._lock = _singleton()
        # key -> (detail, first_at, last_logged_at). first_at dates the fault
        # for the "(still, Ns)" suffix; last_logged_at drives the repeat
        # window. They must be separate — see _condition.
        self._conditions: dict[str, tuple[Optional[str], float, float]] = {}
        self.snapshot: dict = {}
        self.tray = tray_mod.Tray(
            on_toggle=self.toggle,
            on_quit=self.quit,
            on_open=self.open_inbox,
            on_skip=self.skip_item,
            on_clear_completed=self.clear_completed,
            on_open_transcript=self.open_transcript,
        )
        self._serve_socket()
        # Drains the inbox in its own thread so a long transcription can never
        # stall the tray or make status unpollable.
        self.worker = worker_mod.Worker()
        self.worker.start()
        GLib.timeout_add(POLL_MS, self._tick)
        GLib.timeout_add(10000, self._drain)
        self._tick()

    # -- status ----------------------------------------------------------
    def _condition(self, key: str, detail: Optional[str], *,
                   level: int = logging.WARNING, recovered: str = "recovered") -> None:
        """Report a tick-rate condition on CHANGE, not once per second.

        Swallowing a tick exception into a snapshot field is right — the tray
        must survive a broken ledger — but it was ALSO the only record of it,
        and nobody reads a JSON field they have no reason to open. So each of
        these now reaches the journal too. `detail=None` clears the condition.

        Deduplicated because _tick runs at 1 Hz: an unconditional line is 86k
        journal entries a day, which buries the signal just as thoroughly as
        printing nothing did. Re-asserted every LOG_REPEAT_S so a fault that
        outlives the journal window still says so.
        """
        seen, first_at, last_at = self._conditions.get(key, (None, 0.0, 0.0))
        now = time.monotonic()
        if detail is None:
            if seen is not None:
                self._conditions.pop(key, None)
                log.info("%s %s", key, recovered)
            return
        if detail == seen and (now - last_at) < LOG_REPEAT_S:
            return
        # The repeat window is measured from the LAST log, not from first_at.
        # Measuring it from first_at meant that once a fault outlived
        # LOG_REPEAT_S the re-assert never reset its own timer, so the
        # condition logged on every 1 Hz tick forever — observed doing exactly
        # that for diarization_degraded at "(still, 1158s/1159s/1160s)".
        repeat = detail == seen
        self._conditions[key] = (detail, first_at if repeat else now, now)
        log.log(level, "%s: %s%s", key, detail,
                f" (still, {int(now - first_at)}s)" if repeat else "")

    def _tick(self) -> bool:
        try:
            snap = state.snapshot()
            # Mint ledger rows for anything that appeared in the inbox by ANY
            # route — hotkey, Syncthing, a script, a hand-drop. INBOX IS INBOX.
            try:
                ledger.reconcile_inbox(origin="inbox")
                ledger.note_machine("stream", snap.get("stream", {}))
                ledger.note_machine("inbox", snap.get("inbox", {}))
                snap = ledger.enrich(snap)
                self._condition("ledger_error", None)
            except Exception as e:  # noqa: BLE001 - ledger trouble must not blind the tray
                snap["ledger_error"] = str(e)
                self._condition("ledger_error", f"{type(e).__name__}: {e}")
        except Exception as e:  # noqa: BLE001 - a status error must not kill the loop
            snap = {"error": str(e), "stream": {"state": "error"}, "inbox": {"state": "error"}}
            self._condition("snapshot_error", f"{type(e).__name__}: {e}", level=logging.ERROR)
        else:
            self._condition("snapshot_error", None)
        # Sub-stage health from contract A. The tray colour can only carry one
        # summary; these are the two facts that ran at 100% failure for a week
        # behind a green icon, so they get their own journal line the moment
        # they change.
        #
        # Guarded on the block EXISTING, not on its contents: when enrich() did
        # not run the keys are absent, and reading that as "not failing" would
        # log a recovery the daemon has no evidence for — the same false
        # all-clear this whole change exists to stop.
        if snap.get("passes") is not None:
            health = snap["passes"]
            self._condition(
                "passes_failed",
                (f"{health['failed']} item(s) with a failed pass at the current version "
                 f"({', '.join(health.get('slugs') or []) or 'unknown slug'}) — "
                 f"retry with `wax ep sweep`") if health.get("failed") else None,
                recovered="cleared")
        if snap.get("diarization") is not None:
            diar = snap["diarization"]
            self._condition(
                "diarization_degraded",
                (f"the newest {diar.get('recent_undiarized')} transcript(s) have no speakers; "
                 f"run `wax doctor` to see which dependency is missing")
                if diar.get("degraded") else None,
                recovered="cleared")
        self.snapshot = snap
        active = (snap.get("inbox") or {}).get("active_item")
        stage = (snap.get("inbox") or {}).get("active_stage")
        queue_items = []
        try:
            queue_items = ledger.tray_items(active, stage)
            active_row = next((item for item in queue_items if item.get("active")), None)
            if active_row:
                progress = transcribe_adapter.progress_for(active_row["item_id"])
                if progress:
                    active_row.update(progress)
                    stage = active_row.get("stage") or stage
                    snap["inbox"]["active_stage"] = stage
                    if active_row.get("progress_pct") is not None:
                        snap["inbox"]["active_progress_pct"] = active_row["progress_pct"]
                verb = tray_mod.STAGE_VERBS.get(stage, stage or "working").lower()
                if active_row.get("progress_pct") is not None:
                    verb = f"{verb} {active_row['progress_pct']}%"
                elapsed = int((snap.get("inbox") or {}).get("active_elapsed_s") or 0)
                snap["inbox"]["evidence"] = (
                    f"{verb} {active_row['orig_name']} · {elapsed // 60}m {elapsed % 60:02d}s"
                )
            self._condition("tray_queue_error", None)
        except Exception as e:  # noqa: BLE001 - queue UI must not affect recording
            snap["tray_queue_error"] = str(e)
            self._condition("tray_queue_error", f"{type(e).__name__}: {e}")
        colour, tip = tray_mod.colour_for(snap)
        self.tray.set(colour, tip, recording=(snap.get("stream", {}).get("state") == "recording"))
        try:
            self.tray.set_queue(queue_items)
        except Exception as e:  # noqa: BLE001 - queue UI must not affect recording
            snap["tray_queue_error"] = str(e)
            self._condition("tray_menu_error", f"{type(e).__name__}: {e}")
        self._mirror(snap, colour)
        return True

    def _drain(self) -> bool:
        """Publish queued events. Failure is expected and harmless — rows stay
        unpublished and the backlog shows up in status."""
        try:
            events_mod.drain()
            self._condition("outbox_drain_error", None)
        except Exception as e:  # noqa: BLE001
            # Deduplicated like the tick conditions: a NATS outage fires this
            # every 10 s, and the backlog count in status is the real measure.
            self._condition("outbox_drain_error", f"{type(e).__name__}: {e}")
        return True

    def _mirror(self, snap: dict, colour: str) -> None:
        """Degraded-mode mirror: readable even if the socket is wedged."""
        payload = dict(snap)
        payload["daemon"] = {"pid": os.getpid()}
        payload["tray"] = {"colour": colour, "registered": self.tray.registered}
        try:
            payload["outbox_backlog"] = events_mod.backlog()
        except Exception as e:  # noqa: BLE001
            # Report WHY, don't swallow into None — an unexplained null in a
            # status field is how you end up debugging the monitor instead of
            # the system.
            payload["outbox_backlog"] = None
            payload["outbox_error"] = f"{type(e).__name__}: {e}"
            self._condition("outbox_backlog_error", f"{type(e).__name__}: {e}")
        tmp = paths.STATE_JSON.with_suffix(".tmp")
        try:
            tmp.write_text(json.dumps(payload, indent=2, sort_keys=True, default=str))
            os.replace(tmp, paths.STATE_JSON)
            self._condition("state_mirror_error", None)
        except OSError as e:
            # `wax doctor` calls a stale mirror a FAILED probe, so the daemon
            # had better be able to say why it went stale.
            self._condition("state_mirror_error", str(e))

    # -- socket ----------------------------------------------------------
    def _serve_socket(self) -> None:
        daemon = self

        class Handler(socketserver.BaseRequestHandler):
            def handle(self):
                # Timeout so one wedged reader cannot make status unpollable.
                self.request.settimeout(10)
                try:
                    self.request.sendall(
                        json.dumps(daemon.snapshot, indent=2, sort_keys=True, default=str).encode() + b"\n"
                    )
                except (OSError, socket.timeout):
                    pass

        class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
            daemon_threads = True
            allow_reuse_address = True

        try:
            paths.SOCK.unlink(missing_ok=True)
            self.server = Server(str(paths.SOCK), Handler)
        except OSError as e:
            log.error("socket unavailable (%s); state.json mirror at %s still written",
                      e, paths.STATE_JSON)
            return
        threading.Thread(target=self.server.serve_forever, daemon=True).start()

    # -- actions ---------------------------------------------------------
    def toggle(self) -> None:
        # Runs the same CLI path the hotkey uses, so there is exactly one
        # toggle implementation and one lock protecting it.
        threading.Thread(
            target=lambda: subprocess.run(
                [sys.executable, str(COMPONENT_ROOT / "bin" / "wax"), "rec", "toggle"],
                check=False,
            ),
            daemon=True,
        ).start()

    def open_inbox(self) -> None:
        subprocess.Popen(["xdg-open", str(paths.INBOX)])

    def open_transcript(self, md_path: str) -> None:
        path = Path(md_path)
        if not path.is_file():
            tray_mod._notify("Wax: transcript missing", str(path))
            return
        subprocess.Popen(["xdg-open", tray_mod.obsidian_uri(str(path))])

    def skip_item(self, item_id: str) -> None:
        def act():
            try:
                result = worker_mod.skip_item(item_id)
                tray_mod._notify("Wax: item skipped", Path(result["path"]).name)
            except Exception as e:  # noqa: BLE001 - operator feedback, daemon stays alive
                tray_mod._notify("Wax: could not skip item", str(e))
        threading.Thread(target=act, daemon=True).start()

    def clear_completed(self) -> None:
        try:
            ledger.clear_tray_completed()
            inbox = self.snapshot.get("inbox") or {}
            self.tray.set_queue(ledger.tray_items(inbox.get("active_item"), inbox.get("active_stage")))
        except Exception as e:  # noqa: BLE001
            tray_mod._notify("Wax: could not clear completed", str(e))

    def quit(self) -> None:
        # Never stops an in-flight encoder: it lives in its own scope.
        try:
            self.worker.stop()
        except Exception:  # noqa: BLE001
            pass
        try:
            self.server.shutdown()
        except Exception:  # noqa: BLE001
            pass
        paths.SOCK.unlink(missing_ok=True)
        Gtk_main_quit()


def Gtk_main_quit():
    from gi.repository import Gtk
    Gtk.main_quit()


def main() -> int:
    from gi.repository import Gtk
    # Before ANY wax module can log. Everything below this line is now capable
    # of reaching the journal; nothing above it was.
    _configure_logging()
    # One startup line naming what this process actually resolved. Two outages
    # were prolonged by an assumed ledger path and an assumed transcriber, both
    # of which are answerable in one line at boot.
    log.info("waxd %d starting: root=%s ledger=%s vault=%s passes=%s level=%s",
             os.getpid(), paths.AUDIO, paths.DB, paths.VAULT,
             os.environ.get("WAX_PASSES_DIR", "<component default>"),
             logging.getLevelName(logging.getLogger().level))
    try:
        transcriber = transcribe_adapter.transcribe_command()
        log.info("transcriber: %s (diarization %s)",
                 transcriber, transcribe_adapter.diarization_mode())
    except transcribe_adapter.TranscribeError as e:
        # Not fatal here — the worker raises per item — but it is the single
        # most useful thing to know at boot, so it must not wait for an item.
        log.error("transcriber unresolvable: %s (run `wax doctor`)", e)
    Daemon()
    try:
        Gtk.main()
    except KeyboardInterrupt:
        pass
    log.info("waxd %d exiting", os.getpid())
    return 0


if __name__ == "__main__":
    sys.exit(main())
