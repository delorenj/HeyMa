[Unit]
Description=Wax recorder daemon (tray + state mirror)
Documentation=@WAX_DOCUMENTATION_URI@
After=pipewire.service
OnFailure=wax-alert.service

[Service]
Type=simple
ExecStart=@WAX_EXEC_START@
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
PrivateTmp=false
Environment=@WAX_PATH_ENV@
Environment=WAX_SEGMENT_SECONDS=60
Environment=MAX_AUDIO_FILE_SIZE_FOR_TRANSCRIPTION=300MB
Environment=MAX_AUDIO_DURATION_FOR_TRANSCRIPTION=3h
Environment=WAX_DIARIZATION=1
Environment=WAX_DIARIZATION_DEVICE=cuda
# Pin the transcriber by absolute path. `transcribe` used to be found on PATH,
# where a ~/.local/bin symlink pointed at a SECOND checkout 9 commits behind —
# so a `git reset --hard` in a tree nobody was editing silently disabled
# diarization for the tree everybody was. PATH must never get to decide which
# code runs. Rendered from the checkout that installs it, exactly like
# ExecStart, so the pin relocates with the repo instead of naming one machine.
Environment=@WAX_TRANSCRIBE_ENV@
# The versioned `transcriptions` store (docs/TRANSCRIPTIONS-STORE.md D.9). The DSNs carry no
# password; the passwords are op:// references by item UUID, resolved at runtime with `op read`
# (OP_SERVICE_ACCOUNT_TOKEN is in waxd's environ). `wax` reads these same lines from the INSTALLED
# unit, so the CLI and the daemon share one config and no credential file is ever written.
# The UUIDs are the DeLoSecrets items "Transcriptions Postgres App" / "... Owner", created by
# `deploy/provision-transcriptions --apply` on 2026-10-28 (re-running it reuses them). A store
# outage never fails a pass (capture still queues). Rollback: WAX_TRANSCRIPTS=0.
Environment=WAX_TRANSCRIPTS_DSN=postgresql://transcriptions_app@localhost:5432/transcriptions?application_name=waxd
Environment=WAX_TRANSCRIPTS_PASSWORD_OP=op://DeLoSecrets/dncjuqof2przgk6me6ct6f2xma/password
Environment=WAX_TRANSCRIPTS_OWNER_DSN=postgresql://transcriptions_owner@localhost:5432/transcriptions?application_name=wax-migrate
Environment=WAX_TRANSCRIPTS_OWNER_PASSWORD_OP=op://DeLoSecrets/xgnmsebepsybgd627rtudh2iuq/password
# SELECT-only reader for `wax transcripts browse`, which Holocene's Transcripts tab spawns
# (docs/HOLOCENE-TRANSCRIPTS-TAB.md B.7, C.1). waxd never connects as it; the CLI reads these lines
# from the installed unit. DeLoSecrets item "Transcriptions Postgres RO".
Environment=WAX_TRANSCRIPTS_RO_DSN=postgresql://transcriptions_ro@localhost:5432/transcriptions?application_name=wax-browse
Environment=WAX_TRANSCRIPTS_RO_PASSWORD_OP=op://DeLoSecrets/jdt6hd7awwzxd376agaszc7z3u/password
Environment=WAX_S3_ENDPOINT=https://s3.delo.sh

[Install]
WantedBy=default.target
