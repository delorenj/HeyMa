#!/usr/bin/python3
"""wax.ep.v1 classification v2: what kind of recording is this?

Four stored classes (frontmatter.CLASSIFICATIONS): monolog, meeting, phone_call
and other. The design of record is docs/HOLOCENE-TRANSCRIPTS-TAB.md A.1-A.7.

Rules run in order and the first that matches wins:

  1. An empty body is a skip (`empty_document`), never a failure.
  2. An existing classification is kept and no call is made, unless
     --reclassify / WAX_CLASSIFICATION_RECLASSIFY=1 asks for a redo (below).
  3. Telnyx rule: `source-audio` named `telnyx-*` is a phone_call (every call
     leg, even a 3 s one with four words). No model, no cost.
  4. Floor rule: under 15 words AND under 10 s of audio is `other` with
     detail `no_content` (silence, noise). Telnyx legs are exempt (rule 3).
  5. Jev (TypeSafe jev-1.13.0, through the fleet Jev ingress at jev.delo.sh):
     one request, two questions. `kind` is a `choice` over monolog / meeting /
     phone_call / household / no_content; `is_phone` is a `noul`.

Mapping. The top `kind` is accepted at P >= WAX_CLASSIFICATION_MIN_P (0.6).
`household` and `no_content` both store `other`; the specific label goes to
`classification-detail`. The two questions disagreeing (kind is not phone_call
while is_phone > 0.9, or kind is phone_call while is_phone < 0.5) is an
ABSTAIN, as is a low top probability: the pass completes with NO
`classification`, `classification-detail: unsorted`, and the confidence and
candidates recorded. An absent value is not `monolog`, so diarization still
runs. A transport or malformed-answer failure fails the pass with the
`provider_*` reason code from wax.jev; the runner's attempts retry it.

Frontmatter written: classification, classification-detail,
classification-confidence (top probability, 3 decimals) and
classification-source (`jev-1.13.0`, `rule:telnyx` or `rule:floor`).

--reclassify (A.6, F.5) redoes a note whose value was set by v1's chat model
(no `classification-source`) or by an earlier rule/Jev run. A value whose
source is anything else is a human's decision and is kept unless
--force-human is also given. If Jev abstains on a note that already has a
value, the old value stays untouched (the evidence says so): abstaining must
not erase what we knew. An abstain on an ordinary DOCUMENT (item `doc-...`)
stores `other` with detail `unsorted` instead, so doc-standard still titles it. The script prints the result it would apply and
writes nothing; Wax applies it.

It never prints document text or provider bodies.
"""

import os
import re
import sys
from pathlib import Path
from typing import Any, Optional


COMPONENT_ROOT = next(
    parent for parent in Path(__file__).resolve().parents
    if (parent / "pyproject.toml").is_file()
)
sys.path.insert(0, str(COMPONENT_ROOT / "src"))

from wax import frontmatter, jev, provider  # noqa: E402


CLASSES = frontmatter.CLASSIFICATIONS
# What Jev may answer for `kind`; household and no_content both store `other`.
KINDS = ("monolog", "meeting", "phone_call", "household", "no_content")
DETAIL_FOR_KIND = {"household": "household", "no_content": "no_content"}
STORED_AS = {"household": "other", "no_content": "other"}

DEFAULT_MIN_P = 0.6
# Disagreement band between the two questions (A.2).
PHONE_REJECT_ABOVE = 0.9
PHONE_REQUIRE_ABOVE = 0.5
FLOOR_WORDS = 15
FLOOR_SECONDS = 10.0
HEAD_CHARS = 6_000
TAIL_CHARS = 2_000
# HeyMa's dedicated jev-litellm virtual key (alias heyma-wax-classification,
# $0.50/day); never the ingress master key, never project-extraction's key.
DEFAULT_KEY_OP = "op://DeLoSecrets/lmtarsmlr35gqyydjsw245mvra/credential"
KEY_ENV = "WAX_JEV_API_KEY"
RECLASSIFY_ENV = "WAX_CLASSIFICATION_RECLASSIFY"
# Sources this pass writes itself; anything else on an existing value is a human's.
OWN_SOURCE = re.compile(r"^(jev-[\w.]+|rule:[a-z]+)$")
SPEAKER_RE = re.compile(r"^\*\*Speaker (\d+)\b", re.MULTILINE)

KIND_QUESTION = jev.choice(
    "What kind of recording is `transcript`? `recording` describes the file it came from and is a hint, "
    "not a rule. The transcript comes from speech recognition and may be garbled.",
    {
        "monolog": "One person talking to themself, a recorder or an assistant: reflecting, dictating, "
                   "narrating, brainstorming or leaving themself a voice memo.",
        "meeting": "A work or business conversation, appointment or interview between adults, in person "
                   "or on a video call.",
        "phone_call": "A telephone call or voicemail, including IVR menus, robocalls, hold music and "
                      "voicemail greetings.",
        "household": "Family and home life: children, play, meals, chores, car rides, or ambient house audio.",
        "no_content": "Silence, noise, or no usable speech.",
    })
PHONE_QUESTION = jev.noul(
    "Is `transcript` a recording of a telephone call or voicemail, including an automated menu, "
    "a robocall or a voicemail greeting?",
    true="It is a telephone call, voicemail or automated phone system.",
    false="It is not a telephone call.")


def audio_name(fm: dict[str, Any]) -> str:
    """The recorded file's name, whichever key the note carries it under."""
    wax = fm.get(frontmatter.WAX_KEY)
    for value in (fm.get("source-audio"), wax.get("source_audio") if isinstance(wax, dict) else None):
        if isinstance(value, str) and value.strip():
            return os.path.basename(value.strip())
    return ""


def duration_s(fm: dict[str, Any]) -> Optional[float]:
    value = fm.get("audio-duration-seconds")
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return float(value)


def rule_result(classification: str, source: str, detail: Optional[str] = None,
                existing: Optional[dict[str, Any]] = None) -> dict[str, Any]:
    updates: dict[str, Any] = {"classification": classification, "classification-confidence": 1.0,
                               "classification-source": source}
    if detail:
        updates["classification-detail"] = detail
    elif existing and existing.get("classification-detail"):
        updates["classification-detail"] = ""  # a stale detail from an earlier run must not outlive it
    return {"wax_ep_version": 1, "frontmatter": updates, "evidence": {"rule": source.split(":", 1)[1]}}


def window_text(text: str) -> str:
    if len(text) <= HEAD_CHARS + TAIL_CHARS:
        return text
    return text[:HEAD_CHARS] + "…" + text[-TAIL_CHARS:]


def decide(fm: dict[str, Any], text: str) -> dict[str, Any]:
    """One Jev request, mapped to a stored class or an abstain (never a write)."""
    name = audio_name(fm)
    duration = duration_s(fm)
    state = {
        "recording": {
            "source": name[:80] or None,
            "speaker_count": len({m for m in SPEAKER_RE.findall(text)}),
            "duration_s": round(duration, 1) if duration is not None else None,
            "word_count": len(text.split()),
        },
        "transcript": window_text(text),
    }
    key = provider.resolve_key(env_var=KEY_ENV,
                               op_ref=os.environ.get("WAX_JEV_API_KEY_OP", DEFAULT_KEY_OP).strip())
    decision = jev.decide(
        state, {"kind": KIND_QUESTION, "is_phone": PHONE_QUESTION}, key=key,
        model=os.environ.get("WAX_JEV_MODEL", "").strip() or jev.DEFAULT_MODEL,
        url=os.environ.get("WAX_JEV_URL", "").strip() or jev.DEFAULT_URL)

    answer = decision.answers["kind"]
    probabilities = {k: round(float(v), 3) for k, v in answer["probabilities"].items()}
    kind = answer["choice"]
    top = float(answer["probabilities"].get(kind, answer.get("confidence", 0.0)))
    is_phone = decision.noul("is_phone")
    threshold = provider.env_number("WAX_CLASSIFICATION_MIN_P", DEFAULT_MIN_P, minimum=0.01, maximum=1.0)
    ranked = sorted(probabilities.items(), key=lambda item: (-item[1], item[0]))

    abstain = ""
    if top < threshold:
        abstain = "low_confidence"
    elif kind != "phone_call" and is_phone > PHONE_REJECT_ABOVE:
        abstain = "kind_disagrees_with_is_phone"
    elif kind == "phone_call" and is_phone < PHONE_REQUIRE_ABOVE:
        abstain = "kind_disagrees_with_is_phone"

    evidence = {
        "model": decision.model,
        "cost": decision.cost,
        "input_tokens": decision.input_tokens,
        "request_ids": [decision.request_id] if decision.request_id else [],
        "kind": kind,
        "kind_probabilities": dict(ranked),
        "candidates": [name for name, _ in ranked[:2]],
        "is_phone": round(is_phone, 3),
        "threshold": threshold,
        "outcome": f"abstain:{abstain}" if abstain else "accepted",
    }
    return {"kind": kind, "top": round(top, 3), "abstain": abstain, "model": decision.model,
            "evidence": evidence}


def build_result(md: Path, *, reclassify: bool = False, force_human: bool = False,
                 document: bool = False) -> dict[str, Any]:
    fm, body = frontmatter.read(md)
    # 1. empty body
    if not body.strip():
        # An empty note has nothing to classify; that is a skip, not a failure.
        return {"wax_ep_version": 1, "state": "skipped", "reason_code": "empty_document"}

    # 2. existing value
    existing = fm.get("classification")
    if existing:
        if existing not in CLASSES:
            raise provider.ProviderError("existing classification is unsupported; preserving it",
                                         "invalid_classification")
        source = str(fm.get("classification-source") or "").strip()
        human = bool(source) and not OWN_SOURCE.match(source)
        if not reclassify or (human and not force_human):
            return {"wax_ep_version": 1, "frontmatter": {"classification": existing}}

    text = provider.document_text(body)

    # 3. telnyx rule
    if audio_name(fm).lower().startswith("telnyx-"):
        return rule_result("phone_call", "rule:telnyx", existing=fm)

    # 4. floor rule
    duration = duration_s(fm)
    if len(text.split()) < FLOOR_WORDS and duration is not None and duration < FLOOR_SECONDS:
        return rule_result("other", "rule:floor", detail="no_content", existing=fm)

    # 5. Jev
    verdict = decide(fm, text)
    evidence = verdict["evidence"]
    if verdict["abstain"]:
        if existing:
            # --reclassify on a valued note: keep what we knew, say what Jev thought.
            evidence["kept"] = existing
            return {"wax_ep_version": 1, "frontmatter": {"classification": existing}, "evidence": evidence}
        updates = {"classification-detail": "unsorted", "classification-confidence": verdict["top"],
                   "classification-source": verdict["model"]}
        if document:
            # An ordinary document (item `doc-...`) is not shown under "Unsorted", and doc-standard
            # titles only a note that has a classification: an abstain is a stray `other`.
            updates["classification"] = "other"
        return {"wax_ep_version": 1, "evidence": evidence, "frontmatter": updates}

    kind = verdict["kind"]
    updates: dict[str, Any] = {
        "classification": STORED_AS.get(kind, kind),
        "classification-confidence": verdict["top"],
        "classification-source": verdict["model"],
    }
    detail = DETAIL_FOR_KIND.get(kind)
    if detail:
        updates["classification-detail"] = detail
    elif fm.get("classification-detail"):
        updates["classification-detail"] = ""
    return {"wax_ep_version": 1, "frontmatter": updates, "evidence": evidence}


def main(argv: Optional[list[str]] = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    reclassify = os.environ.get(RECLASSIFY_ENV, "").strip().lower() in {"1", "true", "yes", "on"}
    force_human = False
    positional = []
    for arg in args:
        if arg == "--reclassify":
            reclassify = True
        elif arg == "--force-human":
            force_human = True
        else:
            positional.append(arg)
    if not positional:
        print("usage: classification [--reclassify [--force-human]] DOCUMENT.md [ITEM_ID]", file=sys.stderr)
        return 2
    md = Path(positional[0]).expanduser().resolve()
    if not md.is_file():
        return provider.fail("run_error", f"not a document file: {md}")
    try:
        document = len(positional) > 1 and positional[1].startswith("doc-")
        result = build_result(md, reclassify=reclassify, force_human=force_human, document=document)
    except provider.ProviderError as exc:
        return provider.fail(exc.reason_code, str(exc))
    except OSError as exc:
        return provider.fail("run_error", f"{type(exc).__name__}: {exc}")
    except Exception as exc:  # noqa: BLE001 - the first stderr line is always reason_code=
        return provider.fail("run_error", f"{type(exc).__name__}: {exc}")
    provider.emit_result(result)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
