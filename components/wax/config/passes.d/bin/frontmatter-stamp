#!/usr/bin/python3
"""Stamp durable provenance onto a transcript: duration, source, model.

Deliberately trivial and dependency-free — its job is to be a REAL pass that
actually runs, so the framework is proven by something other than a mock.
"""
import json, sqlite3, sys
from pathlib import Path
component_root = next(
    parent for parent in Path(__file__).resolve().parents
    if (parent / "pyproject.toml").is_file()
)
sys.path.insert(0, str(component_root / "src"))
from wax import frontmatter

md = Path(sys.argv[1])
from wax import paths

db = sqlite3.connect(paths.DB); db.row_factory = sqlite3.Row
row = db.execute("SELECT t.*, i.orig_name, i.bytes FROM transcripts t "
                 "JOIN items i USING(item_id) WHERE t.md_path=?", (str(md),)).fetchone()
if not row:
    print(f"no ledger row for {md}", file=sys.stderr); sys.exit(1)
frontmatter.merge(md, {
    "source-audio": row["orig_name"],
    "duration-seconds": round(row["audio_duration"] or 0, 2),
    "engine-model": row["engine_model"],
    "word-count": row["word_count"],
})
print(f"stamped {md.name}")
