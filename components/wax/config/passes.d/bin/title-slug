#!/usr/bin/python3
"""wax.ep.v1 title/summary producer backed by a hosted OpenAI-compatible endpoint.

Local inference is retired for this pass. `qwen3.6:latest` was deleted from the
Ollama host on 2026-08-15 and every run 404'd for the next five days without one
human-visible symptom, so the provider is now pure configuration: base URL, model
id, and 1Password key path arrive as contract-C env injected from
title-slug.yaml. The route is the AutomaticAI gateway's `automaticai/auto/fast`
(titles/summaries role) on the scoped `heyma-wax-inference` token; any
OpenAI-compatible POST /chat/completions works, so switching routes is a
three-value edit in the YAML, never a code change.

Context window is NOT a reason to pick one: transcript_context() truncates to
MAX_CONTEXT_CHARS (24,000 chars, ~6k tokens) before anything leaves this process,
so a 10M-token window buys exactly nothing here. Choose on titling quality and
price.

Failure is loud on purpose. The old code caught urllib.error.URLError, which
silently swallows its HTTPError subclass, and rendered it as the bare string
"HTTP Error 404: Not Found" — discarding the response body that named the
deleted model. That one lossy line is why the outage lasted five days. Every
failure path here now emits `reason_code=<code>` as the FIRST line of stderr
(contract D), followed by the provider's own words.

The pass is otherwise side-effect free: it reads one transcript and emits a
declarative result on stdout. Wax owns frontmatter writes, collision-safe
renames, ledger updates, and S3 linkage.
"""

import http.client
import json
import os
import re
import subprocess
import sys
import unicodedata
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Optional


COMPONENT_ROOT = next(
    parent for parent in Path(__file__).resolve().parents
    if (parent / "pyproject.toml").is_file()
)
sys.path.insert(0, str(COMPONENT_ROOT / "src"))

from wax import frontmatter  # noqa: E402
from wax import provider as chat_provider  # noqa: E402

ProviderError = chat_provider.ProviderError


MAX_CONTEXT_CHARS = 24_000
# The response is two short strings. Leaving this unset makes OpenRouter price
# the request against the model's full 65,536-token output ceiling and reject a
# perfectly affordable title request when the key has a lower spend limit.
MAX_OUTPUT_TOKENS = 2_048

# Provider defaults. Every one of these is overridable from title-slug.yaml's
# env block; the defaults exist so the pass still runs from a bare shell.
DEFAULT_API_BASE = "https://api.automaticai.io/v1"
DEFAULT_MODEL = "automaticai/auto/fast"
# Tried in order after DEFAULT_MODEL (wax.provider.run_chain): the explicit
# subscription GLM routes, then the metered Hyper routes, then the free family.
# The GLM routes sit right after the primary because on 2026-10-22 auto/fast,
# Hyper and free all answered 503 (no channel) while explicit personal GLM
# answered 200. Operator order of 2026-10-22: nothing Anthropic, ever; Hyper and
# free are fallbacks. chat_pass_routing_test fails if an Anthropic name appears.
DEFAULT_MODEL_FALLBACKS = ("automaticai/personal/glm-5.3-flash,automaticai/personal/glm-5.3,"
                           "automaticai/hypercharm/glm-5.3,automaticai/hypercharm/minimax-m3,"
                           "automaticai/free")
DEFAULT_API_KEY_OP = "op://DeLoSecrets/yeurk5dpqkaarspvsn3cjtmkki/heyma-wax-inference"
# Per request, and never past the chain deadline (wax.provider.Deadline).
DEFAULT_REQUEST_TIMEOUT_S = 60.0
# Mirrors timeout_s in title-slug.yaml / classification.yaml; the chain budget
# when the runner did not say (WAX_PASS_TIMEOUT_S unset: a bare-shell run).
# 6 members x 60s + catalog 10s + op read 5s = 375s <= 390s - RESERVE_S.
DEFAULT_PASS_TIMEOUT_S = 390.0

# Preflight is a cheap catalog lookup; it must never be the reason a run is slow.
PREFLIGHT_TIMEOUT_S = 10.0
# `op read` is a local IPC round-trip to an already-authenticated agent. If it
# has not answered in 5s something is wrong with op, not with the network.
OP_READ_TIMEOUT_S = 5.0

# strict json_schema requires "additionalProperties": false AND every property
# named in "required" — both already true below, so this schema is usable as-is.
RESULT_SCHEMA = {
    "type": "object",
    "properties": {
        "title": {"type": "string"},
        "summary": {"type": "string"},
    },
    "required": ["title", "summary"],
    "additionalProperties": False,
}

# Non-fatal observations. They are held back rather than printed as they happen
# so that on failure `reason_code=` is genuinely the first line of stderr.
_NOTES: list[str] = []

# Which reference actually produced the key on this run. A 401 is always a
# statement about one specific credential, so the failure must name it: the
# whole cost of the 2026-09-08 outage was a message that said "User not found"
# and never said *whose* key was not found.
_KEY_SOURCE = "unresolved"


class TitlePassError(chat_provider.ProviderError):
    """A pass failure carrying the contract-D classification for the runner.

    A ProviderError, so the shared model chain can read its status and marker.
    """

    def __init__(self, message: str, *, reason_code: str = "run_error",
                 status: Optional[int] = None, detail_code: Optional[str] = None) -> None:
        super().__init__(message, reason_code, status=status, detail_code=detail_code)


def note(message: str) -> None:
    _NOTES.append(message)


def _flush_notes() -> None:
    for message in _NOTES:
        print(message, file=sys.stderr)


def slugify(value: str, max_length: int = 80) -> str:
    ascii_value = unicodedata.normalize("NFKD", value).encode("ascii", "ignore").decode("ascii")
    slug = re.sub(r"[^a-z0-9]+", "-", ascii_value.lower()).strip("-")
    slug = slug[:max_length].rstrip("-")
    if not slug:
        raise TitlePassError("the generated title cannot be converted to a filename slug",
                             reason_code="provider_bad_response")
    return slug


def transcript_context(body: str) -> str:
    text = body.strip()
    if len(text) <= MAX_CONTEXT_CHARS:
        return text
    # Meetings often state their purpose early and decisions late. Retain both
    # rather than sending an arbitrary prefix to the title model.
    return text[:16_000] + "\n\n[... middle omitted ...]\n\n" + text[-8_000:]


def _op_read(reference: str) -> str:
    """Resolve one op:// reference, or "" if it does not exist.

    VERIFIED 2026-08-19: OP_SERVICE_ACCOUNT_TOKEN is present in waxd's environ,
    so `op read` succeeds unattended under `systemd-run --user`.
    """
    if not reference:
        return ""
    try:
        proc = subprocess.run(["op", "read", reference], capture_output=True,
                              text=True, timeout=OP_READ_TIMEOUT_S)
    except (OSError, subprocess.TimeoutExpired) as exc:
        note(f"note: `op read {reference}` unavailable ({exc})")
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def resolve_api_key(*, primary_ref: str, fallback_ref: str = "") -> str:
    """First non-empty of: direct env, then the dedicated gateway op:// ref.

    There is no fallback reference and no ambient provider key: the gateway
    token is the only credential this pass sends. `fallback_ref` is accepted
    and ignored so older callers keep working.

    No branch of this ever writes a key to disk, and nothing but the op://
    reference is allowed into a tracked file.
    """
    global _KEY_SOURCE

    direct = os.environ.get("WAX_TITLE_API_KEY", "").strip()
    if direct:
        _KEY_SOURCE = "$WAX_TITLE_API_KEY"
        return direct

    key = _op_read(primary_ref)
    if key:
        _KEY_SOURCE = primary_ref
        return key

    raise TitlePassError(f"dedicated gateway credential did not resolve: {primary_ref}", reason_code="no_api_key")




def _http_failure(exc: urllib.error.HTTPError, *, url: str, model: str) -> TitlePassError:
    """Turn an HTTP error into the most specific reason_code its body supports."""
    error = _classify_http_failure(exc, url=url, model=model)
    error.route = chat_provider.gateway_route(exc.headers)
    return error


def _classify_http_failure(exc: urllib.error.HTTPError, *, url: str, model: str) -> TitlePassError:
    try:
        body = exc.read().decode("utf-8", "replace").strip()
    except (OSError, ValueError, http.client.HTTPException):
        # A drained, already-closed or truncated error body is still a real
        # HTTP failure; losing the body must never lose the whole diagnosis.
        body = ""
    detail = f"HTTP {exc.code} from {url}: {body[:300] or exc.reason}"
    lowered = body.lower()
    marker = chat_provider._marker(body)
    if exc.code in (400, 404) and ((model and model.lower() in lowered) or "not a valid model" in lowered):
        return TitlePassError(f"{detail} -- model {model!r} is not served here",
                              reason_code="missing_model", status=exc.code, detail_code=marker)
    if exc.code == 403 and marker == "model_out_of_scope":
        return TitlePassError(f"{detail} -- model {model!r} is outside the key's scope",
                              reason_code="provider_auth_rejected", status=exc.code, detail_code=marker)
    if exc.code in (401, 403):
        # OpenRouter answers a *management/provisioning* key with the same
        # `401 User not found.` it gives a revoked one, so the body alone cannot
        # tell "wrong key class" from "dead account". Name the source and the
        # one-line test instead of making the next person rediscover it.
        return TitlePassError(
            f"{detail} -- key from {_KEY_SOURCE} was rejected; confirm it is an "
            f"inference key, not a management/provisioning key: "
            f"GET {api_base_of(url)}/key returns is_provisioning_key=false",
            reason_code="provider_auth_rejected", status=exc.code, detail_code=marker)
    # Status classes match wax.provider, so the model chain reads both alike.
    reason = {402: "provider_quota_exceeded", 429: "provider_rate_limited",
              400: "provider_bad_request"}.get(exc.code, "provider_http_error")
    return TitlePassError(detail, reason_code=reason, status=exc.code, detail_code=marker)


def api_base_of(url: str) -> str:
    """The /v1 base a request URL was built from, for use in operator hints."""
    for suffix in ("/chat/completions", "/models"):
        if url.endswith(suffix):
            return url[: -len(suffix)]
    return url.rsplit("/", 1)[0]


def _api_request(url: str, *, key: str, model: str, timeout: float,
                 payload: Optional[dict[str, Any]] = None,
                 response_headers: Optional[dict[str, str]] = None) -> dict[str, Any]:
    """One OpenAI-compatible call. GET when payload is None, else POST.

    `response_headers`, when given, is filled with the success response's
    headers (the gateway names the route that served in them).
    """
    data = json.dumps(payload).encode() if payload is not None else None
    headers = {"Authorization": f"Bearer {key}", "User-Agent": "HeyMa-Wax/1.0"}
    if data is not None:
        headers["Content-Type"] = "application/json"
    if "openrouter.ai" in url:
        # OpenRouter attributes spend and rate limits to these. Without them
        # wax's usage is indistinguishable from every other holder of the key.
        headers["HTTP-Referer"] = "https://delo.sh/wax"
        headers["X-Title"] = "wax title-slug"
    request = urllib.request.Request(
        url, data=data, headers=headers, method="POST" if data is not None else "GET")
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            raw = response.read()
            if response_headers is not None:
                response_headers.update(response.headers.items())
        return json.loads(raw.decode("utf-8", "replace"))
    except urllib.error.HTTPError as exc:
        # MUST be caught before URLError: HTTPError subclasses it, and catching
        # the parent first is precisely what discarded the body naming the model.
        raise _http_failure(exc, url=url, model=model) from exc
    except (OSError, http.client.HTTPException) as exc:
        # URLError and timeouts are OSErrors. http.client.HTTPException is not:
        # a body cut short (IncompleteRead) or a garbled status line once
        # escaped this handler and killed the pass with a bare traceback.
        error = chat_provider.transport_error(exc, url, timeout)
        raise TitlePassError(str(error), reason_code=error.reason_code,
                             detail_code=error.detail_code) from exc
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise TitlePassError(f"{url} returned a non-JSON body: {exc}",
                             reason_code="provider_bad_response") from exc


def served_ids(*, api_base: str, api_key: str,
               deadline: Optional[chat_provider.Deadline] = None) -> Optional[set[str]]:
    """The model ids the key can see, or None when the catalog is unreadable.

    A deleted model is the failure that started all of this, and catching it on
    a 10s catalog GET costs nothing. Nothing is cached: the point is to observe
    the provider's state on this run. Not every OpenAI-compatible provider
    exposes /models, and an unreadable catalog is not evidence the model is
    gone, so None never blocks anything.
    """
    url = f"{api_base}/models"
    timeout = PREFLIGHT_TIMEOUT_S if deadline is None else deadline.request_timeout(PREFLIGHT_TIMEOUT_S)
    if timeout < chat_provider.MIN_REQUEST_S:
        note("note: model preflight skipped (no time left in the chain budget)")
        return None
    try:
        with chat_provider.wall_clock_limit(None if deadline is None else timeout + chat_provider.HARD_GRACE_S):
            payload = _api_request(url, key=api_key, model="", timeout=timeout)
    except (chat_provider.ProviderError, chat_provider.DeadlineExceeded) as exc:
        note(f"note: model preflight skipped ({exc})")
        return None
    entries = payload.get("data") if isinstance(payload, dict) else None
    ids = {str(entry.get("id")) for entry in (entries or []) if isinstance(entry, dict)}
    if not ids:
        note(f"note: {url} listed no models; preflight skipped")
        return None
    return ids


def preflight_model(*, api_base: str, model: str, api_key: str) -> None:
    """Confirm one model is listed before shipping 24k chars at it."""
    ids = served_ids(api_base=api_base, api_key=api_key)
    if ids is not None and not chat_provider.is_listed(model, ids):
        raise TitlePassError(
            f"model {model!r} is not among the {len(ids)} models served by {api_base}/models",
            reason_code="missing_model")


def model_chain() -> list[str]:
    return chat_provider.model_chain("WAX_TITLE_MODEL", "WAX_TITLE_MODEL_FALLBACKS",
                                     default_primary=DEFAULT_MODEL,
                                     default_fallbacks=DEFAULT_MODEL_FALLBACKS)


def run_model_chain(call, *, api_base: str, api_key: str,
                    deadline: Optional[chat_provider.Deadline] = None,
                    request_timeout: Optional[float] = None) -> tuple[Any, dict[str, Any]]:
    """Run `call(model, timeout)` down the chain: (value, evidence naming who served).

    The chain is preflighted against the catalog ONCE: a member the key cannot
    see is skipped (recorded as missing_model), never a reason to stop, so a
    primary that left the catalog costs nothing but its entry in the evidence.
    The catalog lookup and every member share one deadline (see wax.provider).
    """
    models = model_chain()
    ids = served_ids(api_base=api_base, api_key=api_key, deadline=deadline)
    listed = None if ids is None else (lambda model: chat_provider.is_listed(model, ids))
    chain = chat_provider.run_chain(models, call, listed=listed, deadline=deadline,
                                    request_timeout=request_timeout)
    for item in chain.attempts:
        note(f"note: {item['model']} did not serve ({item['reason_code']}); fell through")
    return chain.value, chat_provider.evidence_for(models, chain.model, chain.attempts,
                                                   chain.provenance)


def chat_request(api_base: str, *, key: str, model: str, timeout: float,
                 payload: dict[str, Any]) -> tuple[dict[str, Any], dict[str, str]]:
    """POST one chat completion: (response, provenance), an Anthropic server refused.

    Provenance is what the gateway says served the request: the body's
    `model` (served_by), X-AutomaticAI-Route and the auto decision header.
    """
    headers: dict[str, str] = {}
    response = _api_request(f"{api_base}/chat/completions", key=key, model=model,
                            timeout=timeout, payload=payload, response_headers=headers)
    provenance = chat_provider.provenance_of(response, headers)
    chat_provider.refuse_anthropic(model, provenance)
    return response, provenance


def _parse_json_content(content: str) -> dict[str, Any]:
    text = (content or "").strip()
    # Find JSON block if it's wrapped in fences, even with conversational prefix
    match = re.search(r"```(?:json)?\n(.*?)\n```", text, re.DOTALL | re.IGNORECASE)
    if match:
        text = match.group(1).strip()
    elif text.startswith("```"):
        text = re.sub(r"^```[A-Za-z0-9]*\n?", "", text)
        text = re.sub(r"\n?```$", "", text).strip()
    else:
        # Fallback: if no fences, try to extract first { to last }
        start = text.find("{")
        end = text.rfind("}")
        if start != -1 and end != -1 and end > start:
            text = text[start:end+1]
    
    try:
        result = json.loads(text)
    except json.JSONDecodeError as exc:
        raise TitlePassError(f"model returned non-JSON content: {text[:300]!r}",
                             reason_code="provider_bad_response") from exc
    if not isinstance(result, dict):
        raise TitlePassError("model returned a non-object result",
                             reason_code="provider_bad_response")
    return result


def hosted_enrichment(body: str, *, model: str, api_base: str, api_key: str,
                      timeout: float, existing_title: str = "",
                      existing_summary: str = "",
                      provenance: Optional[dict[str, str]] = None) -> dict[str, str]:
    prompt = """Create durable metadata for this private audio transcript.

Return a specific title and a factual summary. The title must be 4-10 words,
must describe the actual subject, and must not contain a date, filename,
speaker label, or generic words such as transcript, recording, audio, meeting,
or conversation. The summary must be 1-3 concise sentences grounded only in
the supplied transcript. Do not infer names or facts that are not present.
"""
    if existing_title:
        prompt += f"\nPreserve this existing title exactly: {existing_title}\n"
    if existing_summary:
        prompt += f"\nPreserve this existing summary exactly: {existing_summary}\n"
    prompt += "\nTRANSCRIPT:\n" + transcript_context(body)

    payload, served = chat_request(
        api_base,
        key=api_key,
        model=model,
        timeout=timeout,
        payload={
            "model": model,
            "max_tokens": MAX_OUTPUT_TOKENS,
            # Top-level temperature is the OpenAI-compatible spelling; Ollama's
            # options{} block and its `think` flag are not portable and are gone.
            "temperature": 0.1,
            "response_format": {
                "type": "json_schema",
                "json_schema": {
                    "name": "transcript_metadata",
                    "strict": True,
                    "schema": RESULT_SCHEMA,
                },
            },
            "messages": [
                {"role": "system", "content": "Return only the requested JSON object."},
                {"role": "user", "content": prompt},
            ],
        },
    )
    if provenance is not None:
        provenance.update(served)
    try:
        content = payload["choices"][0]["message"]["content"]
    except (KeyError, IndexError, TypeError) as exc:
        # Providers signal quota and moderation stops in the envelope, not with a
        # status code, so surface the envelope rather than an AttributeError.
        raise TitlePassError(
            f"no message content in provider response: {json.dumps(payload)[:300]}",
            reason_code="provider_bad_response") from exc
    result = _parse_json_content(content)
    title = str(result.get("title") or "").strip()
    summary = str(result.get("summary") or "").strip()
    if not title or not summary:
        raise TitlePassError(f"{model} returned an empty title or summary",
                             reason_code="provider_bad_response")
    return {"title": title, "summary": summary}


def _request_timeout() -> float:
    raw = os.environ.get("WAX_TITLE_REQUEST_TIMEOUT_S", "").strip()
    try:
        return float(raw) if raw else DEFAULT_REQUEST_TIMEOUT_S
    except ValueError:
        note(f"note: WAX_TITLE_REQUEST_TIMEOUT_S={raw!r} is not a number; "
             f"using {DEFAULT_REQUEST_TIMEOUT_S:g}s")
        return DEFAULT_REQUEST_TIMEOUT_S


def build_result(md: Path) -> dict[str, Any]:
    fm, body = frontmatter.read(md)
    if not body.strip():
        raise TitlePassError(f"transcript has no body: {md}")
    existing_title = str(fm.get("title") or "").strip()
    existing_summary = str(fm.get("summary") or "").strip()
    existing_slug = str(fm.get("title-slug") or "").strip()
    evidence: Optional[dict[str, Any]] = None
    if existing_title and existing_summary:
        enriched = {"title": existing_title, "summary": existing_summary}
    else:
        api_base = os.environ.get("WAX_TITLE_API_BASE", DEFAULT_API_BASE).strip().rstrip("/")
        deadline = chat_provider.pass_deadline(DEFAULT_PASS_TIMEOUT_S)
        api_key = resolve_api_key(
            primary_ref=os.environ.get("WAX_TITLE_API_KEY_OP", DEFAULT_API_KEY_OP).strip(),
        )

        def enrich(member: str, timeout: float) -> chat_provider.Answer:
            served: dict[str, str] = {}
            value = hosted_enrichment(
                body,
                model=member,
                api_base=api_base,
                api_key=api_key,
                timeout=timeout,
                existing_title=existing_title,
                existing_summary=existing_summary,
                provenance=served,
            )
            return chat_provider.Answer(value, served)

        enriched, evidence = run_model_chain(enrich, api_base=api_base, api_key=api_key,
                                             deadline=deadline, request_timeout=_request_timeout())
        # Enrichment never clobbers grounded values a person or prior pass set.
        enriched["title"] = existing_title or enriched["title"]
        enriched["summary"] = existing_summary or enriched["summary"]
    slug = existing_slug or slugify(enriched["title"])
    result: dict[str, Any] = {
        "wax_ep_version": 1,
        "frontmatter": {
            "title": enriched["title"],
            "summary": enriched["summary"],
            "title-slug": slug,
        },
        "transcript": {"slug": slug},
        "link_audio": True,
    }
    if evidence:
        result["evidence"] = evidence
    return result


def _fail(reason_code: str, detail: str) -> int:
    # Contract D: the runner classifies from the FIRST stderr line, so it goes
    # out ahead of the buffered notes. Keep the whole stream short — the runner
    # only retains the tail of stderr.
    print(f"reason_code={reason_code}", file=sys.stderr)
    print(detail, file=sys.stderr)
    _flush_notes()
    return 1


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: title-slug TRANSCRIPT.md [ITEM_ID]", file=sys.stderr)
        return 2
    md = Path(sys.argv[1]).expanduser().resolve()
    if not md.is_file():
        return _fail("run_error", f"not a transcript file: {md}")
    try:
        result = build_result(md)
    except chat_provider.ProviderError as exc:
        return _fail(exc.reason_code, str(exc))
    except Exception as exc:  # noqa: BLE001 - contract D: never a bare traceback
        return _fail("run_error", f"{type(exc).__name__}: {exc}")
    print(json.dumps(result, ensure_ascii=False))
    _flush_notes()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
