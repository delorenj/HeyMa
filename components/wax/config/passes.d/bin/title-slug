#!/usr/bin/python3
"""wax.ep.v1 title/summary producer backed by the local Ollama service.

The pass is deliberately side-effect free: it reads one transcript and emits a
declarative result on stdout. Wax owns frontmatter writes, collision-safe
renames, ledger updates, and S3 linkage.
"""

import json
import os
import re
import sys
import unicodedata
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any


COMPONENT_ROOT = next(
    parent for parent in Path(__file__).resolve().parents
    if (parent / "pyproject.toml").is_file()
)
sys.path.insert(0, str(COMPONENT_ROOT / "src"))

from wax import frontmatter  # noqa: E402


MAX_CONTEXT_CHARS = 24_000
RESULT_SCHEMA = {
    "type": "object",
    "properties": {
        "title": {"type": "string"},
        "summary": {"type": "string"},
    },
    "required": ["title", "summary"],
    "additionalProperties": False,
}


class TitlePassError(RuntimeError):
    pass


def slugify(value: str, max_length: int = 80) -> str:
    ascii_value = unicodedata.normalize("NFKD", value).encode("ascii", "ignore").decode("ascii")
    slug = re.sub(r"[^a-z0-9]+", "-", ascii_value.lower()).strip("-")
    slug = slug[:max_length].rstrip("-")
    if not slug:
        raise TitlePassError("the generated title cannot be converted to a filename slug")
    return slug


def transcript_context(body: str) -> str:
    text = body.strip()
    if len(text) <= MAX_CONTEXT_CHARS:
        return text
    # Meetings often state their purpose early and decisions late. Retain both
    # rather than sending an arbitrary prefix to the title model.
    return text[:16_000] + "\n\n[... middle omitted ...]\n\n" + text[-8_000:]


def ollama_enrichment(body: str, *, model: str, endpoint: str,
                      existing_title: str = "", existing_summary: str = "") -> dict[str, str]:
    prompt = """Create durable metadata for this private audio transcript.

Return a specific title and a factual summary. The title must be 4-10 words,
must describe the actual subject, and must not contain a date, filename,
speaker label, or generic words such as transcript, recording, audio, meeting,
or conversation. The summary must be 1-3 concise sentences grounded only in
the supplied transcript. Do not infer names or facts that are not present.
"""
    if existing_title:
        prompt += f"\nPreserve this existing title exactly: {existing_title}\n"
    if existing_summary:
        prompt += f"\nPreserve this existing summary exactly: {existing_summary}\n"
    prompt += "\nTRANSCRIPT:\n" + transcript_context(body)
    request_body = json.dumps({
        "model": model,
        "stream": False,
        "think": False,
        "format": RESULT_SCHEMA,
        "options": {"temperature": 0.1},
        "messages": [
            {"role": "system", "content": "Return only the requested JSON object."},
            {"role": "user", "content": prompt},
        ],
    }).encode()
    request = urllib.request.Request(
        endpoint.rstrip("/") + "/api/chat",
        data=request_body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    timeout = float(os.environ.get("WAX_TITLE_REQUEST_TIMEOUT_S", "540"))
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            payload = json.loads(response.read())
        content = payload.get("message", {}).get("content", "")
        result = json.loads(content)
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError, KeyError, TypeError) as exc:
        raise TitlePassError(f"local title model failed: {exc}") from exc
    if not isinstance(result, dict):
        raise TitlePassError("local title model returned a non-object result")
    title = str(result.get("title") or "").strip()
    summary = str(result.get("summary") or "").strip()
    if not title or not summary:
        raise TitlePassError("local title model returned an empty title or summary")
    return {"title": title, "summary": summary}


def build_result(md: Path) -> dict[str, Any]:
    fm, body = frontmatter.read(md)
    if not body.strip():
        raise TitlePassError(f"transcript has no body: {md}")
    existing_title = str(fm.get("title") or "").strip()
    existing_summary = str(fm.get("summary") or "").strip()
    existing_slug = str(fm.get("title-slug") or "").strip()
    if existing_title and existing_summary:
        enriched = {"title": existing_title, "summary": existing_summary}
    else:
        enriched = ollama_enrichment(
            body,
            model=os.environ.get("WAX_TITLE_MODEL", "qwen3.6:latest"),
            endpoint=os.environ.get("WAX_OLLAMA_URL", "http://127.0.0.1:11434"),
            existing_title=existing_title,
            existing_summary=existing_summary,
        )
        # Enrichment never clobbers grounded values a person or prior pass set.
        enriched["title"] = existing_title or enriched["title"]
        enriched["summary"] = existing_summary or enriched["summary"]
    slug = existing_slug or slugify(enriched["title"])
    return {
        "wax_ep_version": 1,
        "frontmatter": {
            "title": enriched["title"],
            "summary": enriched["summary"],
            "title-slug": slug,
        },
        "transcript": {"slug": slug},
        "link_audio": True,
    }


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: title-slug TRANSCRIPT.md [ITEM_ID]", file=sys.stderr)
        return 2
    md = Path(sys.argv[1]).expanduser().resolve()
    if not md.is_file():
        print(f"not a transcript file: {md}", file=sys.stderr)
        return 2
    try:
        print(json.dumps(build_result(md), ensure_ascii=False))
    except TitlePassError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
