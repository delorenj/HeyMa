        }
      },
      {
        "id": "4b5eb74b-ce64-414d-a2d9-e9b8f456bca5",
        "name": "Build Failed Event",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1568,
          192
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "let t = {};\ntry { t = JSON.parse($input.item.json.stdout); } catch (e) {}\nconst p = $('Prepare Job').first().json;\nconst data = {\n  transcription_id: p.transcriptionId,\n  file_path: p.filePath,\n  error_code: 'engine.error',\n  error_message: (t && t.error) ? String(t.error) : 'transcription failed',\n  retryable: true,\n};\n$input.item.json.failedB64 = Buffer.from(JSON.stringify(data)).toString('base64');\nreturn $input.item;"
        }
      },
