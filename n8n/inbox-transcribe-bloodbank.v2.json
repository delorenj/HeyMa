      {
        "id": "a6e120da-98d2-440e-bb68-a26287a88760",
        "name": "Prepare Job",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          448,
          96
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const j = $input.item.json;\nconst sourcePath = j.sourcePath || j.path;\nconst transcriptionId = String($execution.id);\nconst started = { transcription_id: transcriptionId, file_path: sourcePath, engine: 'whisper' };\nj.sourcePath = sourcePath;\nj.filePath = sourcePath;\nj.transcriptionId = transcriptionId;\nj.srcB64 = Buffer.from(sourcePath, 'utf8').toString('base64');\nj.startedB64 = Buffer.from(JSON.stringify(started)).toString('base64');\nreturn $input.item;"
        }
      },
      {
        "id": "8447bb80-bdc2-499e-b756-20add502fa5a",
        "name": "Emit Transcription Started",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          672,
          96
        ],
        "parameters": {
          "executeOnce": false,
          "command": "=export PATH=\"$HOME/.local/share/mise/shims:$HOME/.local/bin:/usr/local/bin:$PATH\"\nprintf %s '{{ $json.startedB64 }}' | base64 -d | bb-emit --type bloodbank.v1.audio.transcription.started"
        }
      },
      {
        "id": "4f37c594-aad8-46d4-9392-cf1c98bd3783",
        "name": "Secure Source (S3 + stash)",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          896,
          96
        ],
        "parameters": {
          "executeOnce": false,
          "command": "=export PATH=\"$HOME/.local/share/mise/shims:$HOME/.local/bin:/usr/local/bin:$PATH\"\nSRC=\"$(printf %s '{{ $('Prepare Job').first().json.srcB64 }}' | base64 -d)\"\nsecure-source \"$SRC\""
        }
      },
      {
        "id": "48f75a97-b057-43d2-bf3d-345ddb7e4cfe",
        "name": "Transcribe (Whisper)",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          1120,
          96
        ],
        "parameters": {
          "executeOnce": false,
          "command": "=export PATH=\"$HOME/.local/share/mise/shims:$HOME/.local/bin:/usr/local/bin:$PATH\"\nSRC=\"$(printf %s '{{ $('Prepare Job').first().json.srcB64 }}' | base64 -d)\"\nif MD=\"$(transcribe \"$SRC\")\"; then\n  python3 -c 'import json,sys;print(json.dumps({\"ok\":True,\"mdPath\":sys.argv[1]}))' \"$MD\"\nelse\n  RC=$?\n  python3 -c 'import json,sys;print(json.dumps({\"ok\":False,\"rc\":int(sys.argv[1]),\"error\":\"transcription failed; see execution log\"}))' \"$RC\"\nfi"
        }
      },
      {
        "id": "143f26a9-9a3f-44c5-8100-0c9bc0914c0e",
        "name": "Transcribed OK?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          1344,
          96
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "leftValue": "={{ JSON.parse($json.stdout).ok }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          }
        }
      },
      {
        "id": "ff35317b-6c3d-43fe-b372-bf976fa61417",
        "name": "Build Completed Event",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1568,
          0
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "language": "javaScript",
          "jsCode": "const t = JSON.parse($input.item.json.stdout);\nconst p = $('Prepare Job').first().json;\nconst data = {\n  transcription_id: p.transcriptionId,\n  file_path: p.filePath,\n  transcript_text: '',\n  transcript_uri: 'file://' + t.mdPath,\n  engine: 'whisper',\n};\n$input.item.json.mdPath = t.mdPath;\n$input.item.json.completedB64 = Buffer.from(JSON.stringify(data)).toString('base64');\nreturn $input.item;"
        }
      },
      {
        "id": "4ae80b9d-237d-4078-b687-ff5606b53383",
        "name": "Emit Transcription Completed",
        "type": "n8n-nodes-base.executeCommand",
